:javascript
  let archivosCargados = {
    archivo_resolucion: false,
    archivo_contrato: false
  };

  function validarArchivosCargados() {
    const $btn = $('#enviar-button');
    const valFecha = $('#fecha_resolucion').val();
    const tieneFecha = valFecha && valFecha.trim() !== '';

    // Verifica si hay archivo subido previamente en DB o seleccionado en el input de Resolución
    const inputRes = document.getElementById('archivo_resolucion');
    const tieneResDB = $('#archivo_cargado_resolucion').find('a, iframe, embed').length > 0;
    const tieneResInput = inputRes && inputRes.files && inputRes.files.length > 0;
    const tieneResolucion = tieneResDB || tieneResInput || archivosCargados.archivo_resolucion;

    // Verifica si hay archivo subido previamente en DB o seleccionado en el input de Contrato
    const inputCon = document.getElementById('archivo_contrato');
    const tieneConDB = $('#archivo_cargado_contrato').find('a, iframe, embed').length > 0;
    const tieneConInput = inputCon && inputCon.files && inputCon.files.length > 0;
    const tieneContrato = tieneConDB || tieneConInput || archivosCargados.archivo_contrato;

    if (tieneResolucion && tieneContrato && tieneFecha) {
      $btn.removeClass('btn-disabled').prop('disabled', false);
    } else {
      $btn.addClass('btn-disabled').prop('disabled', true);
    }
  }

  function guardarYActualizar(event, nombreCampo, origen) {
    validarArchivosCargados();
    guardarArchivos(event, nombreCampo, origen);
  }

  function guardarArchivos(event, nombreCampo, origen) {
    const archivoInput = document.getElementById(nombreCampo);
    if (!archivoInput || !archivoInput.files || archivoInput.files.length === 0) return;

    const archivo = archivoInput.files[0];
    const formData = new FormData();
    formData.append('archivo', archivo);
    formData.append('nombre_campo', nombreCampo);

    const Id = "#{@tarea_pendiente.nil? ? '' : @tarea_pendiente.id}";
    formData.append('id', Id);

    fetch('/subir_documento_refresh_pagina', {
      method: 'POST',
      body: formData,
      headers: {
        'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
      }
    })
    .then(async response => {
      const text = await response.text();
      try {
        const data = JSON.parse(text);
        if (data.success) {
          archivosCargados[nombreCampo] = true;
        }
      } catch (e) {
        archivosCargados[nombreCampo] = true;
      }
      validarArchivosCargados();
    })
    .catch(error => {
      console.error("Error al subir archivo:", error);
      validarArchivosCargados();
    });
  }

  $(document).ready(function() {
    $('.chosen-control').chosen({
      allow_single_deselect: true,
      no_results_text: 'No se encontraron resultados',
      width: '100%'
    });

    // Carga inicial del estado desde Rails
    archivosCargados.archivo_resolucion = #{@fondo_produccion_limpia.archivo_resolucion.present?};
    archivosCargados.archivo_contrato = #{@fondo_produccion_limpia.archivo_contrato.present?};

    // Escucha en tiempo real cualquier cambio en los campos requeridos
    $(document).on('change keyup input', '#fecha_resolucion, #archivo_resolucion, #archivo_contrato', function() {
      validarArchivosCargados();
    });

    htmlErrorToTooltip('top');
    validarArchivosCargados();
  });

:css
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: -ms-autohiding-scrollbar;
  }

  .table {
    width: 100%;
    max-width: 100%;
    margin-bottom: 1rem;
    background-color: transparent;
  }

  .table tbody + tbody {
    border-top: 2px solid #dee2e6;
  }

  .table .table {
    background-color: #fff;
  }

  .table thead th {
    font-size: 14px;
    border-bottom: 2px solid #dee2e6;
    border-right: 2px solid #dee2e6; 
    border-left: 2px solid #dee2e6;
  }

  .encabezado-form {
    vertical-align: middle;
    border-bottom: 2px solid #dee2e6;
    background-color: #E0EFF6;
    text-align: center;
    font-weight: bold;
  }

  .contenido-form {
    border-bottom: 2px solid #dee2e6;
    border-right: 2px solid #dee2e6; 
    border-left: 2px solid #dee2e6; 
    font-size: 14px !important; 
    vertical-align: top;
    background-color: #fff;
    color: #5d759e;
  }

  .smaller-text { font-size: 11px !important; height: auto !important; padding: 2px 4px !important; }
  .border-text { border: 1px solid #cccccc; border-radius: 4px; background-color: #ffffff; }
  .btn-disabled { opacity: 0.5 !important; cursor: not-allowed !important; pointer-events: none !important; }

- titulo t(:resolucion_contrato)
= simple_form_for @fondo_produccion_limpia, url: adjuntar_resolucion_contrato_fondo_produccion_limpia_path(@tarea_pendiente), html: { multipart: true, autocomplete: :off }, remote: true do |f|
  .row
    .col-12
      .card
        .card-header.p-0
          .p-3
            %h5.no-margin=titulo_instrumento_fpl.html_safe
            %h5.no-margin=titulo_instrumento.html_safe
            %h5.no-margin=titulo_proyecto_fpl.html_safe
            %h5.no-margin=titulo_apl.html_safe
            %h5.no-margin=datos_beneficiario_fpl.html_safe
        .card-header
          %h5.no-margin=t(:adjuntar_resolucion_contrato)
        .card-body
          %div.table-responsive
            %table.table.table-striped.usuarios.no-margin{class: ('users' unless @objetivo.nil? || @objetivo.size <= 0)}
              %thead
                %tr
                  %th.encabezado-form{style: 'width: 25%;'} Documento
                  %th.encabezado-form{style: 'width: 25%;'} Archivos Cargados
                  -if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                    %th.encabezado-form{style: 'width: 25%;'} Subir Documento
              %tbody
                %tr{id: "fila_fecha_resolucion"}
                  %td.contenido-form{style: 'vertical-align: middle;'}
                    %abbr{ title: "Campo requerido" } *
                    Fecha Resolución
                  %td.contenido-form{colspan: (@tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1 ? 2 : 1)}
                    - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                      = f.input :fecha_resolucion, as: :string, label: false, input_html: { id: "fecha_resolucion", type: "date", class: "form-control border-text", style: "font-size: 14px; height: 38px;" }                    
                    - else
                      = l(@fondo_produccion_limpia.fecha_resolucion, format: :default) if @fondo_produccion_limpia.fecha_resolucion.present?
                %tr{id: "fila_resolucion", data: { original_title: "", title: "" }}
                  %td.contenido-form{style: 'vertical-align: middle;'}
                    %abbr{ title: "Campo requerido" } *
                    Archivo Resolución
                  %td.contenido-form{id: "archivo_cargado_resolucion"} 
                    = __descargar_archivo_sin_titulo(f.object.send("archivo_resolucion"), f.object)
                  -if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                    %td.contenido-form
                      = f.file_field :archivo_resolucion, id: "archivo_resolucion", name: "archivo_resolucion", class: "form-control border-text", onchange: "guardarYActualizar(event, 'archivo_resolucion', 'resolucion')", label: false, style: "font-size: 14px; padding: 4px;"
                %tr{id: "fila_contrato", data: { original_title: "", title: "" }}
                  %td.contenido-form{style: 'vertical-align: middle;'}
                    %abbr{ title: "Campo requerido" } *
                    Archivo Contrato
                  %td.contenido-form{id: "archivo_cargado_contrato"} 
                    = __descargar_archivo_sin_titulo(f.object.send("archivo_contrato"), f.object)
                  -if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                    %td.contenido-form
                      = f.file_field :archivo_contrato, id: "archivo_contrato", name: "archivo_contrato", class: "form-control border-text", onchange: "guardarYActualizar(event, 'archivo_contrato', 'contrato')", label: false, style: "font-size: 14px; padding: 4px;"
  .float-right
    = volver_root
    -if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
      = button_tag t(:enviar), 
        'data-disable-with' => "<i class='fa fa-spinner fa-spin'></i> Enviando...".html_safe, 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success btn-disabled", 
        disabled: true,
        data: { confirm: "¿Está seguro que desea enviar los documentos?", remote: false }