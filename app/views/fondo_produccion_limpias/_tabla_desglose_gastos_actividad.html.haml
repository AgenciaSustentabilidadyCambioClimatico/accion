:javascript
  function sanitizarComprobante(input) {
    let valor = input.value.replace(/[^a-zA-Z0-9]/g, '');
    if (valor.length > 10) {
      valor = valor.substring(0, 10);
    }
    if (input.value !== valor) {
      input.value = valor;
    }
  }

  function sanitizarDecimalesYCalcular(input) {
    let valor = input.value.replace(/[^0-9,]/g, '');
    const partes = valor.split(',');
    if (partes.length > 2) {
      valor = partes[0] + ',' + partes.slice(1).join('').replace(/,/g, '');
    }
    if (partes.length === 2 && partes[1].length > 2) {
      valor = partes[0] + ',' + partes[1].substring(0, 2);
    }
    if (input.value !== valor) {
      input.value = valor;
    }
    calcularCostoRendidoFila(input);
  }

  function calcularCostoRendidoFila(elemento) {
    const $tr = $(elemento).closest('tr');
    
    const $inputVisCantidad = $tr.find('.input-cantidad-rendida');
    const $inputVisValorUnitario = $tr.find('.input-valor-unitario-rendido');
    
    const $hiddenCantidad = $tr.find('.real-cantidad-rendida');
    const $hiddenValorUnitario = $tr.find('.real-valor-unitario-rendido');
    
    let cantidad = parseFloat($inputVisCantidad.val().replace(',', '.'));
    if (isNaN(cantidad) || cantidad < 0) { cantidad = 0; }
    
    let valorUnitario = parseFloat($inputVisValorUnitario.val().replace(',', '.'));
    if (isNaN(valorUnitario) || valorUnitario < 0) { valorUnitario = 0; }

    $hiddenCantidad.val(cantidad);
    $hiddenValorUnitario.val(valorUnitario);

    const formateador = new Intl.NumberFormat('es-CL', {
      style: 'currency',
      currency: 'CLP',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    });

    const costoRendido = cantidad * valorUnitario;
    const $cellCosto = $tr.find('.cell-costo-rendido');
    $cellCosto.data('val-costo', costoRendido);
    $cellCosto.text(formateador.format(costoRendido));

    const costoSolicitado = parseFloat($tr.find('.cell-costo-solicitado').data('val-solicitado')) || 0;
    let saldo = costoSolicitado - costoRendido;
    if (saldo < 0) { saldo = 0; }
    
    const $cellSaldo = $tr.find('.cell-saldo');
    $cellSaldo.data('val-saldo', saldo);
    $cellSaldo.text(formateador.format(saldo));

    // 1. Recalcular Totales de la Tabla Específica
    const $table = $tr.closest('table');
    let totalSolicitado = 0;
    let totalRendido = 0;
    let totalSaldo = 0;

    $table.find('.cell-costo-solicitado').each(function() {
      totalSolicitado += parseFloat($(this).data('val-solicitado')) || 0;
    });

    $table.find('.cell-costo-rendido').each(function() {
      totalRendido += parseFloat($(this).data('val-costo')) || 0;
    });

    $table.find('.cell-saldo').each(function() {
      totalSaldo += parseFloat($(this).data('val-saldo')) || 0;
    });

    const $cellTotalRendido = $table.find('.cell-total-costo-rendido');
    $cellTotalRendido.text(formateador.format(totalRendido));
    $table.find('.cell-total-saldo').text(formateador.format(totalSaldo));

    // VALIDACIÓN EXCESO DE MONTO RENDIDO (Contra el Saldo Disponible)
    const $msgExceso = $table.closest('.table-responsive-container').find('.msg-exceso-monto');
    if (totalRendido > totalSolicitado) {
      $cellTotalRendido.removeClass('text-success').addClass('text-danger');
      $table.addClass('has-exceso-error');
      $msgExceso.slideDown(200);
    } else {
      $cellTotalRendido.removeClass('text-danger').addClass('text-success');
      $table.removeClass('has-exceso-error');
      $msgExceso.slideUp(200);
    }

    // 2. Recalcular Gran Total General de la Actividad
    const $container = $tr.closest('.card-body');
    let granTotalRendido = 0;
    let granTotalSaldo = 0;

    $container.find('.cell-costo-rendido').each(function() {
      granTotalRendido += parseFloat($(this).data('val-costo')) || 0;
    });

    $container.find('.cell-saldo').each(function() {
      granTotalSaldo += parseFloat($(this).data('val-saldo')) || 0;
    });

    $container.find('.cell-gran-total-costo-rendido').text(formateador.format(granTotalRendido));
    $container.find('.cell-gran-total-saldo').text(formateador.format(granTotalSaldo));

    if (typeof validarFormulario === 'function') {
      validarFormulario();
    }
  }

- gastos = local_assigns[:gastos] || {}
- actividad_id_param = local_assigns[:actividad_id]
- es_editable = local_assigns.key?(:es_editable) ? local_assigns[:es_editable] : true

-# OBTENCIÓN ROBUSTA DE PARÁMETROS Y FLUJO
- mes_a_rendir_num = (params[:mes_a_rendir].presence || @rendicion.try(:mes_a_rendir) || 1).to_i
- flujo_id_actual = @rendicion.try(:flujo_id) || @tarea_pendiente.try(:flujo_id) || @flujo.try(:id)

-# CÁLCULO DE HISTÓRICO DE RENDICIONES PREVIAS (< mes_a_rendir_num)
- rendiciones_previas_ids = []
- if flujo_id_actual.present? && mes_a_rendir_num > 1
  - rendiciones_previas_ids = RendicionFpl.where(flujo_id: flujo_id_actual).where('mes_a_rendir < ?', mes_a_rendir_num).pluck(:id)

- cant_hist_hash = {}
- costo_hist_hash = {}
- if rendiciones_previas_ids.present?
  - cant_hist_hash  = RendicionGastoFpl.where(rendicion_fpl_id: rendiciones_previas_ids).group(:categoria, :item_origen_id).sum(:cantidad_rendida)
  - costo_hist_hash = RendicionGastoFpl.where(rendicion_fpl_id: rendiciones_previas_ids).group(:categoria, :item_origen_id).sum(:costo_rendido)

- categorias_def = [ [:rrhh_propios, 'RRHH Propios'], [:rrhh_externos, 'RRHH Externos'], [:operaciones, 'Gastos de Operación'], [:administracion, 'Gastos de Administración'] ]

- rendicion_gastos_map = @rendicion.present? ? @rendicion.rendicion_gastos_fpl.index_by { |g| "#{g.plan_actividad_id}_#{g.categoria}_#{g.item_origen_id}" } : {}

- tipos_aporte_map = {}
- categorias_def.each do |cat_key, _cat_label|
  - gastos[cat_key].to_a.each do |item|
    - tp_raw = item.try(:tipo_aporte).to_s.strip
    - tp_key = tp_raw.downcase
    - if tp_key.present?
      - tipos_aporte_map[tp_key] ||= { label: tp_raw, items_count: 0 }
      - tipos_aporte_map[tp_key][:items_count] += 1

- tiene_gastos = tipos_aporte_map.present?

- gran_total_costo_postulado = 0
- gran_total_costo_rendido = 0
- gran_total_saldo_general = 0

.card.mb-3.border-light
  .card-header.py-2.bg-light.d-flex.justify-content-between.align-items-center
    %span.font-weight-bold.text-secondary{style: "font-size: 12px;"}
      %i.fa.fa-calculator.mr-1
      Presupuesto / Gastos de la Actividad
  .card-body.p-2
    - if tiene_gastos
      - tipos_aporte_map.each do |tp_key, tp_info|
        - total_costo_postulado = 0
        - total_costo_rendido = 0
        - total_saldo_general = 0

        - if tipos_aporte_map.size > 1
          .mt-2.mb-2
            %span.badge.badge-primary{style: "font-size: 12px; padding: 6px 12px;"}
              %i.fa.fa-layer-group.mr-1
              = tp_info[:label]

        .table-responsive-container.mb-3
          .table-responsive
            %table.table.table-bordered.table-sm.no-margin{style: "font-size: 11px;"}
              %thead
                %tr.bg-light
                  %th.encabezado-form{style: "width: 13%;"} Categoría
                  %th.encabezado-form{style: "width: 14%;"} Nombre / Ítem
                  %th.encabezado-form{style: "width: 12%;"} Tipo Aporte
                  %th.encabezado-form{style: "width: 8%;", title: "Saldo restante para esta rendición"} HH / Und. Disponible
                  %th.encabezado-form{style: "width: 8%;"} Valor Unitario
                  %th.encabezado-form{style: "width: 8%;", title: "Saldo restante para esta rendición"} Monto Disponible
                  %th.encabezado-form{style: "width: 8%;"} HH / Und. Rendido
                  %th.encabezado-form{style: "width: 8%;"} Valor Und. Rendido
                  %th.encabezado-form{style: "width: 8%;"} Monto Rendido
                  %th.encabezado-form{style: "width: 6%;"} Saldo
                  %th.encabezado-form{style: "width: 7%;"} N° Documento Respaldo
              %tbody
                - categorias_def.each do |cat_key, cat_label|
                  - items_cat = gastos[cat_key].to_a.select { |i| i.try(:tipo_aporte).to_s.strip.downcase == tp_key }
                  - items_cat.each do |item|
                    - current_act_id = actividad_id_param || item.try(:plan_actividad_id) || item.try(:actividad_id)
                    - row_key = "#{current_act_id}_#{cat_key}_#{item.id}"
                    - g_guardado = rendicion_gastos_map["#{current_act_id}_#{cat_key}_#{item.id}"]
                    - comprobante_ref_val = ""

                    -# LECTURA Y DESCUENTO ROBUSTO DE HISTÓRICOS RENDIDOS
                    - cat_key_str = cat_key.to_s.strip.downcase
                    - item_id_num = item.id.to_i

                    - cant_hist = cant_hist_hash[[cat_key_str, item_id_num]]
                    - cant_hist ||= cant_hist_hash.find { |k, _v| k.is_a?(Array) && k[1].to_i == item_id_num }&.last
                    - cant_hist = cant_hist.to_f

                    - costo_hist = costo_hist_hash[[cat_key_str, item_id_num]]
                    - costo_hist ||= costo_hist_hash.find { |k, _v| k.is_a?(Array) && k[1].to_i == item_id_num }&.last
                    - costo_hist = costo_hist.to_f

                    -# CÁLCULO DEL ORIGINAL POSTULADO
                    - v_unitario_solicitado = (item.try(:valor_hh) || item.try(:valor_unitario) || item.try(:valor)).to_f
                    - hh_postulada_orig = (item.try(:hh) || item.try(:cantidad)).to_f
                    - monto_postulado_orig = item.try(:costo).presence || item.try(:total).presence || (hh_postulada_orig * v_unitario_solicitado)

                    -# MONTO Y UNIDADES DISPONIBLES REALES PARA ESTA RENDICIÓN
                    - hh_postulada = [hh_postulada_orig - cant_hist, 0.0].max
                    - monto_postulado = [monto_postulado_orig - costo_hist, 0.0].max

                    - if g_guardado.present?
                      - cantidad_rendida = [g_guardado.cantidad_rendida.to_f, hh_postulada].min
                      - if g_guardado.respond_to?(:valor_unitario_rendido) && g_guardado.valor_unitario_rendido.present? && g_guardado.valor_unitario_rendido.to_f > 0
                        - v_unitario_rendido = g_guardado.valor_unitario_rendido.to_f
                      - else
                        - v_unitario_rendido = g_guardado.valor_unitario.to_f
                      
                      - monto_rendido = (cantidad_rendida * v_unitario_rendido).round(2)
                      - comprobante_ref_val = g_guardado.try(:comprobante_ref).to_s
                    - else
                      - cantidad_rendida = hh_postulada
                      - v_unitario_rendido = v_unitario_solicitado
                      - monto_rendido = (cantidad_rendida * v_unitario_rendido).round(2)

                    - saldo_actual = [monto_postulado - monto_rendido, 0.0].max

                    -# SUMA CORRECTA DE TOTALES EN CADA ITERACIÓN
                    - total_costo_postulado += monto_postulado
                    - total_costo_rendido += monto_rendido
                    - total_saldo_general += saldo_actual

                    - cantidad_rendida_str = (cantidad_rendida % 1 == 0 ? cantidad_rendida.to_i : cantidad_rendida.round(2)).to_s.tr('.', ',')
                    - v_unitario_rendido_str = (v_unitario_rendido % 1 == 0 ? v_unitario_rendido.to_i : v_unitario_rendido.round(2)).to_s.tr('.', ',')

                    - es_gasto_oper_adm = [:operaciones, :administracion].include?(cat_key)

                    %tr
                      %td.contenido-form= cat_label
                      %td.contenido-form= item.try(:user_name) || item.try(:item) || item.try(:nombre) || '--'
                      %td.contenido-form.text-center= item.try(:tipo_aporte)
                      
                      %td.contenido-form.text-center= "#{hh_postulada} #{item.try(:unidad) || 'HH'}"
                      %td.contenido-form.text-right= number_to_currency(v_unitario_solicitado)
                      
                      %td.contenido-form.text-right.font-weight-bold.cell-costo-solicitado{data: { val_solicitado: monto_postulado }}= number_to_currency(monto_postulado)

                      - if es_editable
                        %td.contenido-form.text-center
                          = hidden_field_tag "gastos_rendidos[#{row_key}][plan_actividad_id]", current_act_id
                          = hidden_field_tag "gastos_rendidos[#{row_key}][categoria]", cat_key
                          = hidden_field_tag "gastos_rendidos[#{row_key}][item_origen_id]", item.id
                          = hidden_field_tag "gastos_rendidos[#{row_key}][tipo_aporte]", item.try(:tipo_aporte)
                          = hidden_field_tag "gastos_rendidos[#{row_key}][cantidad_postulada]", hh_postulada
                          = hidden_field_tag "gastos_rendidos[#{row_key}][costo_postulado]", monto_postulado
                          = hidden_field_tag "gastos_rendidos[#{row_key}][valor_unitario_postulado]", v_unitario_solicitado

                          = hidden_field_tag "gastos_rendidos[#{row_key}][cantidad_rendida]", cantidad_rendida, class: "real-cantidad-rendida"
                          = text_field_tag "vis_cant_#{row_key}", cantidad_rendida_str, class: "form-control smaller-text border-text text-center input-cantidad-rendida", oninput: "sanitizarDecimalesYCalcular(this)", style: "width: 70px; margin: 0 auto;", autocomplete: "off"
                        
                        %td.contenido-form.text-center
                          = hidden_field_tag "gastos_rendidos[#{row_key}][valor_unitario]", v_unitario_rendido, class: "real-valor-unitario-rendido"
                          - if es_gasto_oper_adm
                            = text_field_tag "vis_val_#{row_key}", v_unitario_rendido_str, class: "form-control smaller-text border-text text-center input-valor-unitario-rendido", oninput: "sanitizarDecimalesYCalcular(this)", style: "width: 90px; margin: 0 auto;", autocomplete: "off"
                          - else
                            = hidden_field_tag "vis_val_#{row_key}", v_unitario_rendido_str, class: "input-valor-unitario-rendido"
                            %span.font-weight-bold= number_to_currency(v_unitario_rendido)
                      - else
                        %td.contenido-form.text-center
                          %span.font-weight-bold= cantidad_rendida_str
                        %td.contenido-form.text-center
                          %span.font-weight-bold= number_to_currency(v_unitario_rendido)

                      %td.contenido-form.text-right.font-weight-bold.cell-costo-rendido{data: { val_costo: monto_rendido }}= number_to_currency(monto_rendido)
                      %td.contenido-form.text-right.font-weight-bold.cell-saldo{data: { val_saldo: saldo_actual }}= number_to_currency(saldo_actual)

                      %td.contenido-form.text-center
                        - if es_editable
                          = text_field_tag "gastos_rendidos[#{row_key}][comprobante_ref]", comprobante_ref_val, class: "form-control smaller-text border-text text-center input-comprobante-ref", oninput: "sanitizarComprobante(this)", maxlength: 10, style: "width: 80px; margin: 0 auto; text-transform: uppercase;", autocomplete: "off", placeholder: "Ej: F1234"
                        - else
                          %span.font-weight-bold= comprobante_ref_val.presence || '--'

                - tiene_exceso = total_costo_rendido > total_costo_postulado

                %tr.bg-light{style: "border-top: 2px solid #dee2e6;"}
                  %td.contenido-form.text-right.font-weight-bold{colspan: 5} TOTAL TABLA:
                  %td.contenido-form.text-right.font-weight-bold.text-primary.cell-total-costo-solicitado= number_to_currency(total_costo_postulado)
                  %td.contenido-form{colspan: 2}
                  %td.contenido-form.text-right.font-weight-bold.cell-total-costo-rendido{class: (tiene_exceso ? 'text-danger' : 'text-success')}= number_to_currency(total_costo_rendido)
                  %td.contenido-form.text-right.font-weight-bold.cell-total-saldo= number_to_currency(total_saldo_general)
                  %td.contenido-form

          .msg-exceso-monto.alert.alert-danger.py-1.px-2.mt-1.mb-0.font-weight-bold{style: "font-size: 11px; #{'display: none;' unless tiene_exceso}"}
            %i.fa.fa-exclamation-triangle.mr-1
            El total del Monto Rendido no puede superar al Monto Disponible restante.

        - gran_total_costo_postulado += total_costo_postulado
        - gran_total_costo_rendido += total_costo_rendido
        - gran_total_saldo_general += total_saldo_general

      - if tipos_aporte_map.size > 1
        .card.mt-2.mb-1{style: "background-color: #e9ecef; border: 2px solid #6c757d;"}
          .card-body.py-2.px-3
            .d-flex.justify-content-between.align-items-center.flex-wrap
              %span.font-weight-bold.text-dark{style: "font-size: 13px;"}
                %i.fa.fa-calculator.mr-2.text-primary
                TOTAL GENERAL APORTES DE LA ACTIVIDAD:
              .d-flex.align-items-center.flex-wrap
                .mr-4.my-1
                  %span.text-secondary{style: "font-size: 11px;"} Total Disponible:
                  %strong.text-primary.ml-1{style: "font-size: 13px;"}= number_to_currency(gran_total_costo_postulado)
                .mr-4.my-1
                  %span.text-secondary{style: "font-size: 11px;"} Total Rendido:
                  %strong.text-success.ml-1.cell-gran-total-costo-rendido{style: "font-size: 13px;"}= number_to_currency(gran_total_costo_rendido)
                .my-1
                  %span.text-secondary{style: "font-size: 11px;"} Total Saldo:
                  %strong.text-dark.ml-1.cell-gran-total-saldo{style: "font-size: 13px;"}= number_to_currency(gran_total_saldo_general)
    - else
      .text-center.text-muted.py-2{style: "font-size: 11px;"}
        %i.fa.fa-info-circle.mr-1
        No hay gastos registrados para esta pestaña en esta actividad.