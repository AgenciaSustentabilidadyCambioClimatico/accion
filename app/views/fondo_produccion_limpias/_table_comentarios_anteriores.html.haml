- comentarios = @comentarios.blank? ? [] : @comentarios
- unless comentarios.blank?
  - mostrar_usuario = comentarios.any? { @tarea_pendiente.tarea.codigo == Tarea::COD_FPL_10 }
  .form-group
    %label.string
      Observaciones y comentarios anteriores
  %table.table.table-striped
    %thead
      %tr
        %th=t(:fecha_y_hora)
        - if mostrar_usuario
          %th=t(:usuario)
        -#%th=t(:tarea)
        %th=t(:comentario)
    %tbody
      - comentarios.each do |c|
        %tr
          %td=l c[:created_at], format: '%d-%m-%Y %H:%M:%S'
          - if mostrar_usuario
            %td= @tarea_pendiente.tarea.codigo == Tarea::COD_FPL_10 ? c.user&.nombre_completo : '-'
          -#%td=c.tarea.codigo
          %td=c[:comentario]