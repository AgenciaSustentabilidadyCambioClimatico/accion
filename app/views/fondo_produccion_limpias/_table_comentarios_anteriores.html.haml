- comentarios = @comentarios.blank? ? [] : @comentarios
- unless comentarios.blank?
  - codigo_actual = @tarea_pendiente.try(:tarea)&.codigo
  - mostrar_usuario = [Tarea::COD_FPL_06, Tarea::COD_FPL_10].include?(codigo_actual)

  .form-group
    %label.string
      Observaciones y comentarios anteriores

  %table.table.table-striped
    %thead
      %tr
        %th= t(:fecha_y_hora)
        - if mostrar_usuario
          %th= t(:usuario)
        -#%th= t(:tarea)
        %th= t(:comentario)
    %tbody
      - comentarios.each do |c|
        %tr
          - fecha = c.is_a?(Hash) ? c[:created_at] : c.try(:created_at)
          %td= fecha.present? ? l(fecha, format: '%d-%m-%Y %H:%M:%S') : '-'

          - if mostrar_usuario
            - usuario_obj = c.is_a?(Hash) ? (c[:user] || User.find_by(id: c[:user_id])) : c.try(:user)
            %td= usuario_obj&.nombre_completo.presence || '-'

          -#%td= c.is_a?(Hash) ? c[:tarea] : c.try(:tarea)&.codigo
          - texto_comentario = c.is_a?(Hash) ? (c[:comentario] || c[:observacion]) : (c.try(:comentario) || c.try(:observacion))
          %td= texto_comentario