- fpl_objeto = @fondo_produccion_limpia || FondoProduccionLimpia.new  
- titulo t(:documentos_rendicion)
= simple_form_for fpl_objeto, url: adjuntar_rendicion_subir_documentos_actividades_fondo_produccion_limpia_path(@tarea_pendiente), html: { multipart: true, autocomplete: :off }, remote: true do |f|
  .row
    .col-12
      .card
        .card-header.p-0
          .p-3
            %h5.no-margin=titulo_instrumento_fpl.html_safe
            %h5.no-margin=titulo_instrumento.html_safe
            %h5.no-margin=titulo_proyecto_fpl.html_safe
            %h5.no-margin=titulo_apl.html_safe
            %h5.no-margin=datos_beneficiario_fpl.html_safe
        .card-header
          %h5.no-margin= t(:adjuntar_resolucion_contrato)
        .card-body
          .table-responsive
            %table.table.table-striped.usuarios.no-margin{class: ('users' unless @objetivo.nil? || @objetivo.size <= 0)}
              %thead
                %tr
                  %th.encabezado-form{style: 'width: 10%;'}= t(:n°)
                  %th.encabezado-form{style: 'width: 40%;'}= t(:actividades)
                  %th.encabezado-form{style: 'width: 25%;'} Archivos Cargados
                  - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                    %th.encabezado-form{style: 'width: 25%;'}= t(:subir_documento_rendicion)
              %tbody
                - if @actividad_x_linea.present?
                  - @actividad_x_linea.each do |actividad|
                    - nombre_campo = "archivo_rendicion_#{actividad.id}"
                    - archivo = f.object.respond_to?(nombre_campo) ? f.object.send(nombre_campo) : (actividad.respond_to?(:archivo_rendicion) ? actividad.archivo_rendicion : nil)

                    %tr{id: "fila_actividad_#{actividad.id}"}
                      %td.contenido-form{id: "id_correlativo_plan_actividad_#{actividad.id}", style: 'vertical-align: middle; text-align: center;'}
                        = actividad.correlativo
                      %td.contenido-form{id: "nombre_actividad_#{actividad.id}", style: 'vertical-align: middle;'}
                        = actividad.nombre
                      %td.contenido-form{id: "archivo_cargado_actividad_#{actividad.id}"}
                        = __descargar_archivo_sin_titulo(archivo, f.object)
                        -#
                          = __upload_status(f.object, nombre_campo)
                      - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                        %td.contenido-form{style: 'vertical-align: middle;'}
                          = file_field_tag nombre_campo, id: nombre_campo, class: "form-control smaller-text border-text", onchange: "guardarYActualizar(event, '#{actividad.id}', '#{nombre_campo}', 'rendicion')", label: false
                - else
                  %tr
                    %td.text-center.text-muted{colspan: (@tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1 ? 4 : 3)}
                      No hay actividades asociadas
  .float-right
    = volver_root
    -if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
      = button_tag t(:enviar), 
        'data-disable-with' => "<i class='fa fa-spinner fa-spin'></i> Enviando...".html_safe, 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success btn-disabled", 
        disabled: true,
        data: { confirm: "¿Está seguro que desea enviar los documentos?", remote: false }