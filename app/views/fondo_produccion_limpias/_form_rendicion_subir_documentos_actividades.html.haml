%input#paso_actual_val{type: "hidden", value: paso_actual}

.row
  .col-12
    .card.mb-3
      .card-header.p-0
        .p-3
          %h5.no-margin= titulo_instrumento_fpl.html_safe
          %h5.no-margin= titulo_instrumento.html_safe
          %h5.no-margin= titulo_proyecto_fpl.html_safe
          %h5.no-margin= titulo_apl.html_safe
          %h5.no-margin= datos_beneficiario_fpl.html_safe

-# ==========================================
-# PASO 1: MATRIZ / RESUMEN DE ACTIVIDADES
-# ==========================================
#paso1_resumen{style: ("display: none;" if paso_actual == 2)}

  -# Mensaje dinámico de observación para Rendición Sin Movimientos
  - if es_sin_movimientos && [3, 4].include?(estado_rend_actual)
    .alert.alert-danger.mb-3{style: "border-left: 5px solid #dc3545; background-color: #f8d7da; color: #721c24; border-radius: 4px; padding: 12px 15px;"}
      .d-flex.align-items-start
        %i.fa.fa-exclamation-triangle.fa-2x.mr-3.mt-1{style: "color: #dc3545;"}
        .w-100
          %h6.font-weight-bold.mb-2{style: "font-size: 14px; color: #721c24;"}
            Observaciones a la Rendición Sin Movimientos

          - if obs_tecnica.present?
            .mb-1{style: "font-size: 13px;"}
              %strong.text-dark Revisor Técnico:
              %span= obs_tecnica

          - if obs_financiera_fpl.present?
            .mb-1{style: "font-size: 13px;"}
              %strong.text-dark Revisor Financiero FPL:
              %span= obs_financiera_fpl

          - if obs_financiera_aporte.present?
            .mb-1{style: "font-size: 13px;"}
              %strong.text-dark Revisor Financiero Aporte Propio:
              %span= obs_financiera_aporte

          - if obs_tecnica.blank? && obs_financiera_fpl.blank? && obs_financiera_aporte.blank?
            .mb-1{style: "font-size: 13px;"}
              %strong.text-dark Observación del Revisor:
              %span La rendición sin movimientos presenta observaciones que deben ser subsanadas.

  .card.mb-3
    .card-header.bg-light
      .d-flex.justify-content-between.align-items-center.flex-wrap
        %h5.no-margin.mb-2.mb-md-0 Seleccione las Actividades a Rendir
        .d-flex.align-items-center.flex-wrap
          .d-flex.align-items-center.mr-4.mb-1.mb-md-0
            %span.font-weight-bold.mr-2 Mes a rendir:
            %span.badge.badge-primary{style: "font-size: 13px; padding: 6px 12px;"}= texto_mes_display
          
          .form-check.form-check-inline.mb-1.mb-md-0.mr-3
            = check_box_tag "sin_movimientos_paso1", "1", es_sin_movimientos, class: "form-check-input", id: "chk_sin_movimientos_paso1", disabled: !es_editable
            %label.form-check-label.font-weight-bold.text-secondary{for: "chk_sin_movimientos_paso1"}
              %i.fa.fa-minus-circle.mr-1
              Sin movimientos

          .form-check.form-check-inline.mb-1.mb-md-0
            = check_box_tag "ultima_rendicion_paso1", "1", @rendicion.try(:ultima_rendicion), class: "form-check-input", id: "chk_ultima_rendicion_paso1", disabled: !es_editable
            %label.form-check-label.font-weight-bold.text-danger{for: "chk_ultima_rendicion_paso1"}
              %i.fa.fa-flag.mr-1
              Última rendición

      .card-body
      -# =========================================================================
      -# MENSAJE INFORMATIVO DE DEMO CON ÍCONO DE EXCLAMACIÓN
      -# =========================================================================
      .alert.d-flex.align-items-center.py-2.px-3.mb-3{style: "background-color: #d0e7ff; border: 1px solid #b8daff; color: #004085; border-radius: 4px; font-size: 13px;"}
        %i.fa.fa-exclamation-circle.mr-2{style: "font-size: 16px; color: #004085;"}
        %span Texto demo informativo: Ingrese aquí las instrucciones o mensaje de advertencia.
      .table-responsive
        %table.table.table-bordered.table-striped.no-margin
          %thead
            %tr
              %th.encabezado-form{style: 'width: 5%; text-align: center; vertical-align: middle;', rowspan: 2}= t(:n°)
              %th.encabezado-form{style: 'width: 40%; text-align: center; vertical-align: middle;', rowspan: 2}= t(:actividades)
              %th.encabezado-form{colspan: duracion, style: 'text-align: center; border-right: 1px solid #dee2e6;'}= t(:duracion)
              %th.encabezado-form{style: 'width: 12%; text-align: center; vertical-align: middle;', rowspan: 2} Total
              %th.encabezado-form{style: 'width: 8%; text-align: center; vertical-align: middle;', rowspan: 2} Seleccionar
            %tr
              - (1..duracion).each do |m|
                %th.encabezado-form{style: 'width: 30px; text-align: center;'}= m
          %tbody
            - total_total_suma = 0
            - if @actividad_x_linea.present?
              - @actividad_x_linea.each do |actividad|
                - plan_act = detalles_hash[actividad.id.to_i] || map_planes_by_act_id[actividad.id.to_i] || map_planes_by_id[actividad.id.to_i]
                - act_id_num = actividad.id.to_i
                - plan_act_id_num = plan_act.try(:id).to_i
                - mis_ids = [act_id_num, plan_act_id_num].reject(&:zero?).uniq

                - es_reitimizada = (mis_ids & reitimizadas_ids).any?

                - duracion_act = plan_act.try(:duracion).to_s
                - duraciones = duracion_act.split(',').map(&:strip)
                - es_mes_actual = duraciones.include?(mes_seleccionado_defecto.to_s)

                - es_en_proceso = mis_ids.any? { |id| act_ids_en_proceso.include?(id) }
                - es_observada  = mis_ids.any? { |id| act_ids_observadas.include?(id) } && !es_en_proceso
                - es_borrador   = mis_ids.any? { |id| act_ids_borrador.include?(id) } && !es_en_proceso && !es_observada

                - max_avance_aprobado  = mis_ids.map { |id| avances_aprobados_por_actividad[id] }.max || 0
                - max_avance_proceso   = mis_ids.map { |id| avances_proceso_por_actividad[id] }.max || 0
                - max_avance_observado = mis_ids.map { |id| avances_observados_por_actividad[id] }.max || 0
                - max_avance_borrador  = mis_ids.map { |id| avances_borrador_por_actividad[id] }.max || 0

                - completada_100 = (max_avance_aprobado >= 100) || (max_avance_proceso >= 100)

                - es_mes_previo = duraciones.any? { |m| m.to_i < mes_seleccionado_defecto.to_i }
                - es_pendiente_previo = es_mes_previo && !completada_100
                - tiene_avance_parcial = (max_avance_aprobado > 0 || max_avance_proceso > 0) && !completada_100

                - esta_deshabilitada = !es_editable || completada_100 || es_en_proceso
                - es_sugerida_defecto = es_mes_actual || es_pendiente_previo || tiene_avance_parcial || es_borrador || es_observada
                - debe_marcarse = !esta_deshabilitada && !es_sin_movimientos && es_sugerida_defecto

                - valor_hh_tipo_3 = plan_act.try(:valor_hh_tipo_3).to_f
                - valor_hh_tipos_1_2 = plan_act.try(:valor_hh_tipos_1_2).to_f
                - total_gastos_tipo_1 = plan_act.try(:total_gastos_tipo_1).to_f
                - total_gastos_tipo_2 = plan_act.try(:total_gastos_tipo_2).to_f
                - suma = valor_hh_tipo_3 + valor_hh_tipos_1_2 + total_gastos_tipo_1 + total_gastos_tipo_2
                - total_total_suma += suma

                - tipo_act_val = actividad.try(:tipo_actividad)
                - tipo_act_txt = (tipo_act_val.to_s == '0') ? 'Tipo A' : ((tipo_act_val.to_s == '1') ? 'Tipo B' : nil)

                %tr
                  %td.contenido-form.text-center= actividad.correlativo
                  %td.contenido-form
                    = actividad.nombre
                    - if tipo_act_txt.present?
                      %span.badge.ml-1{style: "font-size: 10px; background-color: #17a2b8; color: #ffffff;", title: "Tipo de Actividad"}
                        = tipo_act_txt
                    - if es_reitimizada
                      %span.badge.ml-1{style: "font-size: 10px; background-color: #6f42c1; color: #ffffff;", title: "Actividad Reitimizada Autorizada"}
                        %i.fa.fa-refresh.mr-1
                        Reitemización autorizada 
                  - (1..duracion).each do |m|
                    %td.contenido-form.text-center
                      - if duraciones.include?(m.to_s)
                        %span.font-weight-bold.text-primary X
                  %td.contenido-form.text-right
                    = number_to_currency(suma)
                  %td.contenido-form.text-center
                    %input.chk-actividad-paso1{type: "checkbox", value: actividad.id, data: { duracion: duracion_act, 'permanente-disabled' => esta_deshabilitada.to_s, 'debe-marcar-defecto' => (!esta_deshabilitada && es_sugerida_defecto).to_s }, checked: debe_marcarse, disabled: esta_deshabilitada || es_sin_movimientos, title: (completada_100 ? "Actividad completada al 100%" : (es_en_proceso ? "Actividad enviada a revisión (En proceso)" : ""))}
                    
                    - if es_en_proceso
                      - txt_av = max_avance_proceso > 0 ? " (#{max_avance_proceso}%)" : ""
                      %span.badge.badge-warning.text-white.d-block.mt-1{style: "font-size: 11px; background-color: #fd7e14;"}= "En revision ASCC #{txt_av}"
                    - elsif es_observada
                      - txt_av = max_avance_observado > 0 ? " (#{max_avance_observado}%)" : ""
                      %span.badge.badge-danger.d-block.mt-1{style: "font-size: 11px; background-color: #dc3545;"}= "Observada#{txt_av}"
                    - elsif completada_100
                      - if max_avance_proceso >= 100 && max_avance_aprobado < 100
                        %span.badge.badge-warning.text-white.d-block.mt-1{style: "font-size: 11px; background-color: #fd7e14;"}= "En revision ASCC (100%)"
                      - else
                        %span.badge.badge-success.d-block.mt-1{style: "font-size: 11px;"} Finalizada 100%
                    - elsif es_borrador && !es_sin_movimientos
                      - txt_av = max_avance_borrador > 0 ? " (#{max_avance_borrador}%)" : ""
                      %span.badge.badge-info.text-white.d-block.mt-1{style: "font-size: 11px;"}= "Borrador#{txt_av}"
                    - elsif (max_avance_aprobado > 0 || max_avance_proceso > 0) && !es_sin_movimientos
                      - max_av_actual = [max_avance_aprobado, max_avance_proceso].max
                      %span.badge.badge-primary.d-block.mt-1{style: "font-size: 11px;"}= "en Ejecución (#{max_av_actual}%)"

            %tr
              %td.contenido-form{style: 'font-weight: bold;', colspan: 2 + duracion} Total
              %td.contenido-form.text-right{style: 'font-weight: bold;'}
                = number_to_currency(total_total_suma)
              %td.contenido-form
      - if es_editable
        .d-flex.justify-content-end.mt-3
          %button.btn.btn-primary#btn-continuar-paso2{type: "button"}
            Continuar a Rendición
            %i.fa.fa-arrow-right.ml-1

-# ==========================================
-# PASO 2: FORMULARIO DE RENDICIÓN POR PESTAÑAS
-# ==========================================
#paso2_formulario{style: ("display: none;" if paso_actual == 1)}
  
  .row.mb-3
    .col-12
      .card.border-info.mb-0{style: "border-width: 2px;"}
        .card-body.p-2.d-flex.align-items-center.justify-content-between.bg-light
          %span.font-weight-bold.text-secondary{style: "font-size: 14px;"}
            %i.fa.fa-calendar-check-o.mr-2.text-info
            Rendición correspondiente a:
          %span.badge.badge-info{style: "font-size: 14px; padding: 6px 14px;"}
            = texto_mes_display

  -# ALERTA Y CONTROL DE GASTOS DE ADMINISTRACIÓN (10% SOBRE PRESUPUESTO TOTAL)
  .alert.py-2.px-3.mb-3{class: (excede_admin ? 'alert-danger' : 'alert-info'), style: "border: 1px solid #{excede_admin ? '#f5c6cb' : '#bee5eb'}; border-radius: 4px; font-size: 13px;"}
    .d-flex.align-items-center
      %i.fa.fa-2x.mr-3{class: (excede_admin ? 'fa-exclamation-triangle text-danger' : 'fa-info-circle text-info')}
      %div
        %strong.d-block{style: "font-size: 14px;"}= excede_admin ? "Error: Límite de Gastos de Administración Excedido" : "Control de Gastos de Administración"
        %span
          El presupuesto asignado a Gastos de Administración no puede superar el <strong>10%</strong> del presupuesto total del proyecto 
          (#{number_to_currency(limite_admin_monto, unit: '$', precision: 0)}). 
          El proyecto tiene asignado un <strong class="#{excede_admin ? 'text-danger' : 'text-success'}">#{number_to_percentage(pct_admin_actual, precision: 1)}</strong> 
          (#{number_to_currency(tot_admin_proyecto, unit: '$', precision: 0)}).

  - tabs = { 'tecnica' => true, 'financiera-fpl' => false, 'financiera-aporte' => false }

  #tab-menu-controls.mb-0.mt-2.px-2{:role => "tabpanel"}
    %ul#manifestacion.nav.nav-tabs{:role => "tablist"}
      - tabs.each do |tab, active|
        %li.nav-item.tab-block{id: "#{tab}-tab"}
          %a.nav-link.tab-block{id: "#{tab}-tab", class: (:active if active), "aria-controls" => tab, "aria-expanded" => "true", "data-toggle" => "tab", :href => "##{tab}", :role => "tab"}
            = t(tab.to_s.gsub('-','_'))

  = simple_form_for fpl_objeto, url: adjuntar_rendicion_subir_documentos_actividades_fondo_produccion_limpia_path(@tarea_pendiente), html: { multipart: true, autocomplete: :off }, remote: true do |f|
    = hidden_field_tag "mes_a_rendir", mes_seleccionado_defecto
    = hidden_field_tag "paso", "2"
    = hidden_field_tag "sin_movimientos", (es_sin_movimientos ? "1" : "0"), id: "hdn_sin_movimientos"
    = hidden_field_tag "actividades_seleccionadas", "", id: "hdn_actividades_seleccionadas"

    .tab-content#manifestacionContent
      
      / -------------------------------------------------------------
      / Pestaña 1: TÉCNICA
      / -------------------------------------------------------------
      .tab-pane.fade.show.active#tecnica{:role => "tabpanel", "aria-labelledby" => "tecnica-tab"}
        .mb-3
          .form-check
            = check_box_tag "ultima_rendicion", "1", @rendicion.try(:ultima_rendicion), class: "form-check-input", id: "chk_ultima_rendicion_form", disabled: !es_editable
            %label.form-check-label.font-weight-bold.text-danger{for: "chk_ultima_rendicion_form"}
              %i.fa.fa-flag.mr-1
              ¿Es la última rendición del proyecto?

        - if @actividad_x_linea.present?
          - @actividad_x_linea.uniq(&:id).each do |actividad|
            - plan_act = detalles_hash[actividad.id.to_i] || map_planes_by_act_id[actividad.id.to_i] || map_planes_by_id[actividad.id.to_i]
            - act_id_num = actividad.id.to_i
            - plan_act_id_num = plan_act.try(:id).to_i
            - mis_ids = [act_id_num, plan_act_id_num].reject(&:zero?).uniq

            - es_reitimizada = (mis_ids & reitimizadas_ids).any?
            - tipo_act_val = actividad.try(:tipo_actividad)
            - tipo_act_txt = (tipo_act_val.to_s == '0') ? 'Tipo A' : ((tipo_act_val.to_s == '1') ? 'Tipo B' : nil)

            - obj_esp_id = plan_act.respond_to?(:attributes) ? (plan_act.attributes['objetivos_especifico_id'] || plan_act.attributes['objetivo_especifico_id']) : nil
            - obj_esp = ObjetivosEspecifico.find_by(id: obj_esp_id) if obj_esp_id.present?
            - indicador_texto = obj_esp.try(:indicadores).presence || obj_esp.try(:descripcion).presence || "Sin indicador registrado."

            - duracion_act = plan_act.try(:duracion).to_s
            - es_pendiente_previo = mis_ids.any? { |id| actividades_no_realizadas_previas.include?(id) }

            - detalle_tecnico = @rendicion&.rendicion_detalles_fpl&.find { |d| (d.tecnica? rescue d.tipo_tab.to_i == 0) && d.rendicion_detalle_actividades_fpl.any? { |rda| mis_ids.include?(rda.plan_actividad_id.to_i) || mis_ids.include?(get_act_id.call(rda.plan_actividad_id.to_i)) } }
            - fecha_inicio_valor = detalle_tecnico&.try(:fecha_inicio)&.try(:strftime, '%Y-%m-%d') || detalle_tecnico&.try(:fecha_inicio)
            - fecha_termino_valor = detalle_tecnico&.try(:fecha_termino)&.try(:strftime, '%Y-%m-%d') || detalle_tecnico&.try(:fecha_termino)
            
            - max_avance_aprobado = mis_ids.map { |id| avances_aprobados_por_actividad[id] }.max || 0
            - min_avance = max_avance_aprobado > 0 ? [max_avance_aprobado + 1, 100].min : 1
            
            - nivel_avance_valor = detalle_tecnico&.nivel_avance.to_s
            - min_avance = [min_avance, nivel_avance_valor.to_i].min if nivel_avance_valor.present? && nivel_avance_valor.to_i > 0
            - opciones_avance = [['Seleccione...', '']] + (min_avance..100).map { |n| ["#{n}%", n.to_s] }
            
            - observacion_valor = detalle_tecnico&.observacion
            - archivo = detalle_tecnico&.archivo
            - url_valor = detalle_tecnico&.try(:url_respaldo) || detalle_tecnico&.try(:url)
            - desc_url_valor = detalle_tecnico&.try(:descripcion_url) || url_valor
            - tiene_archivo = detalle_tecnico&.archivo&.url.present? || url_valor.present?

            .card.mb-2.actividad-tecnica-block{id: "tecnica_actividad_card_#{actividad.id}", 'data-duracion' => duracion_act, 'data-pendiente-previo' => es_pendiente_previo.to_s, style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                  - if tipo_act_txt.present?
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #17a2b8; color: #ffffff;", title: "Tipo de Actividad"}
                      = tipo_act_txt
                  - if es_reitimizada
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #6f42c1; color: #ffffff;", title: "Actividad Reitimizada Autorizada"}
                      %i.fa.fa-refresh.mr-1
                      Reitemización autorizada
                %a.btn.btn-sm.btn-outline-info.collapsed{"data-toggle" => "collapse", href: "#collapse_tecnica_#{actividad.id}", role: "button", "aria-expanded" => "false", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse{id: "collapse_tecnica_#{actividad.id}"}
                .card-body.p-2
                  = hidden_field_tag "actividades_ids[]", actividad.id

                  .alert.d-flex.align-items-center.py-2.px-3.mb-2{style: "background-color: #d0e7ff; border: 1px solid #b8daff; color: #004085; border-radius: 4px; font-size: 12px;"}
                    %span
                      %strong Indicador asociado al objetivo:
                      = indicador_texto

                  .table-responsive
                    %table.table.table-bordered.table-sm.no-margin{style: "font-size: 11px;"}
                      %thead
                        %tr.bg-light
                          %th.encabezado-form{style: 'width: 15%;'} 
                            Fecha de Inicio
                            %span.text-danger *
                          %th.encabezado-form{style: 'width: 15%;'} 
                            Fecha de Término
                            %span.text-danger *
                          %th.encabezado-form{style: 'width: 15%;'} 
                            Nivel de avance
                            %span.text-danger *
                          %th.encabezado-form{style: 'width: 55%;'} 
                            Descripción del Avance
                            %span.text-danger *
                      %tbody
                        %tr
                          %td.contenido-form
                            = date_field_tag "fecha_inicio_actividad_#{actividad.id}", fecha_inicio_valor, class: "form-control smaller-text border-text w-100", disabled: !es_editable, onchange: "validarFormulario()"
                          %td.contenido-form
                            = date_field_tag "fecha_termino_actividad_#{actividad.id}", fecha_termino_valor, class: "form-control smaller-text border-text w-100", disabled: !es_editable, onchange: "validarFormulario()"
                          %td.contenido-form
                            = select_tag "realizada_actividad_#{actividad.id}", options_for_select(opciones_avance, nivel_avance_valor), class: "form-control smaller-text border-text w-100", onchange: "toggleObservacion(this, '#{actividad.id}')", disabled: !es_editable
                          %td.contenido-form
                            = text_area_tag "observacion_actividad_#{actividad.id}", observacion_valor, id: "observacion_actividad_#{actividad.id}", class: "form-control smaller-text border-text w-100", disabled: !es_editable, placeholder: "Ingrese descripción del avance...", rows: 2, onkeyup: "validarFormulario()"

                  .mt-3.mb-2.px-1
                    %h6.font-weight-bold.text-secondary{style: "font-size: 12px;"} 
                      %i.fa.fa-file-pdf-o.mr-1
                      Documento de Respaldo Técnico / Enlace
                  
                  .table-responsive
                    %table.table.table-striped.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 35%;'} Archivo Cargado / Enlace
                          - if es_editable
                            %th.encabezado-form{style: 'width: 65%;'} 
                              Subir Documento Rendición o Enlace URL
                              %span.text-danger *
                      %tbody
                        %tr
                          %td.contenido-form{id: "archivo_cargado_actividad_#{actividad.id}", data: { tiene_archivo: tiene_archivo.to_s }}
                            - if archivo.present?
                              = __descargar_archivo_sin_titulo(archivo, detalle_tecnico || f.object)
                            - elsif url_valor.present?
                              .mt-1
                                = link_to url_valor, target: "_blank", class: "badge badge-info p-2 text-white", style: "font-size: 11px;" do
                                  %i.fa.fa-external-link.mr-1
                                  = desc_url_valor.presence || "Ver Enlace"
                            - else
                              %span.text-muted --
                          - if es_editable
                            %td.contenido-form.p-2
                              = hidden_field_tag "url_rendicion_#{actividad.id}", url_valor, id: "url_rendicion_#{actividad.id}"
                              = hidden_field_tag "url_descripcion_#{actividad.id}", desc_url_valor, id: "url_descripcion_#{actividad.id}"

                              .upload-action-box
                                .d-flex.align-items-center.justify-content-between.flex-wrap
                                  .flex-grow-1.mr-2{style: "min-width: 180px;"}
                                    = file_field_tag "archivo_rendicion_#{actividad.id}", id: "archivo_rendicion_#{actividad.id}", class: "form-control-file smaller-text border-text w-100", onchange: "guardarYActualizar(event, 'archivo_rendicion_#{actividad.id}', 'rendicion');"
                                  .text-right.mt-1.mt-sm-0
                                    %button.btn.btn-sm.btn-primary.shadow-sm{type: "button", style: "font-size: 11px; padding: 4px 10px;", onclick: "abrirModalUrl(#{actividad.id})"}
                                      %i.fa.fa-link.mr-1
                                      Cargar URL

                              .preview-url-container{id: "preview_url_#{actividad.id}"}
                                - if url_valor.present?
                                  .url-badge-container.mt-2
                                    %i.fa.fa-link.text-info.mr-1
                                    = link_to url_valor, target: "_blank", class: "url-badge-link", title: url_valor do
                                      = desc_url_valor.presence || "Ver Enlace"
                                    %button.btn-remove-url{type: "button", onclick: "eliminarUrl('#{actividad.id}')", title: "Eliminar URL"}
                                      %i.fa.fa-times

      / -------------------------------------------------------------
      / Pestaña 2: Financiera FPL (CARGA AJAX LAZY LOADING)
      / -------------------------------------------------------------
      .tab-pane.fade#financiera-fpl{:role => "tabpanel", "aria-labelledby" => "financiera-fpl-tab"}
        - if @actividad_x_linea.present?
          - @actividad_x_linea.each do |actividad|
            - plan_act = detalles_hash[actividad.id.to_i] || map_planes_by_act_id[actividad.id.to_i] || map_planes_by_id[actividad.id.to_i]
            - act_id_num = actividad.id.to_i
            - plan_act_id_num = plan_act.try(:id).to_i
            - mis_ids = [act_id_num, plan_act_id_num].reject(&:zero?).uniq
            
            - es_reitimizada = (mis_ids & reitimizadas_ids).any?
            - tipo_act_val = actividad.try(:tipo_actividad)
            - tipo_act_txt = (tipo_act_val.to_s == '0') ? 'Tipo A' : ((tipo_act_val.to_s == '1') ? 'Tipo B' : nil)

            - duracion_act = plan_act.try(:duracion).to_s
            - es_pendiente_previo = mis_ids.any? { |id| actividades_no_realizadas_previas.include?(id) }
            - docs_act = (@documentos_fpl || []).select { |d| d.rendicion_detalle_actividades_fpl.any? { |rda| mis_ids.include?(rda.plan_actividad_id.to_i) || mis_ids.include?(get_act_id.call(rda.plan_actividad_id.to_i)) } }

            .card.mb-2.actividad-fpl-block{id: "fpl_actividad_card_#{actividad.id}", 'data-duracion' => duracion_act, 'data-pendiente-previo' => es_pendiente_previo.to_s, style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                  - if tipo_act_txt.present?
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #17a2b8; color: #ffffff;", title: "Tipo de Actividad"}
                      = tipo_act_txt
                  - if es_reitimizada
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #6f42c1; color: #ffffff;", title: "Actividad Reitimizada Autorizada"}
                      %i.fa.fa-refresh.mr-1
                      Reitemización autorizada
                %a.btn.btn-sm.btn-outline-info.collapsed{"data-toggle" => "collapse", href: "#collapse_fpl_#{actividad.id}", role: "button", "aria-expanded" => "false", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse{id: "collapse_fpl_#{actividad.id}"}
                .card-body.p-2
                  -# CONTENEDOR AJAX PARA CARGA BAJO DEMANDA AL DESPLEGAR
                  .contenedor-desglose-ajax{id: "container_fpl_#{actividad.id}", data: { url: cargar_desglose_actividad_fondo_produccion_limpia_path(@tarea_pendiente, actividad_id: actividad.id, tipo: 'fpl', mes_a_rendir: mes_seleccionado_defecto, es_reitimizada: es_reitimizada.to_s, es_editable: es_editable.to_s), cargado: "false" }}
                    .text-center.py-3.text-muted
                      %i.fa.fa-spinner.fa-spin.mr-1
                      Cargando detalle de recursos y gastos...

                  .d-flex.justify-content-end.mb-2
                    - if es_editable
                      %button.btn.btn-sm.btn-primary{type: "button", onclick: "agregarFilaDocumentoActividad('filas-fpl-#{actividad.id}', #{actividad.id})"}
                        %i.fa.fa-plus.mr-1
                        Agregar documento

                  .table-responsive
                    %table.table.table-striped.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 35%;'} Archivos Cargados
                          - if es_editable
                            %th.encabezado-form{style: 'width: 55%;'}
                              Subir Documento Rendición
                              %span.text-danger *
                            %th.encabezado-form{style: 'width: 10%;'} Acciones
                      %tbody{id: "filas-fpl-#{actividad.id}"}
                        - if docs_act.present?
                          - docs_act.each do |doc|
                            - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                            - row_key = doc.id
                            %tr
                              %td.contenido-form
                                = hidden_field_tag "documentos_fpl[#{row_key}][id]", doc.id
                                = hidden_field_tag "documentos_fpl[#{row_key}][actividad_ids][]", actividad.id
                                = hidden_field_tag "documentos_fpl[#{row_key}][_destroy]", "0", class: "destroy-flag"
                                = __descargar_archivo_sin_titulo(archivo, doc || f.object)
                              - if es_editable
                                %td.contenido-form
                                  = file_field_tag "documentos_fpl[#{row_key}][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                                %td.contenido-form.text-center
                                  %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)", title: "Eliminar"}
                                    %i.fa.fa-trash
                        - elsif es_editable
                          - row_key = "init_fpl_#{actividad.id}"
                          %tr
                            %td.contenido-form
                              = hidden_field_tag "documentos_fpl[#{row_key}][id]", ""
                              = hidden_field_tag "documentos_fpl[#{row_key}][actividad_ids][]", actividad.id
                              = hidden_field_tag "documentos_fpl[#{row_key}][_destroy]", "0", class: "destroy-flag"
                              = '--'
                            %td.contenido-form
                              = file_field_tag "documentos_fpl[#{row_key}][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                            %td.contenido-form.text-center
                              %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)", title: "Eliminar"}
                                %i.fa.fa-trash

      / -------------------------------------------------------------
      / Pestaña 3: Financiera Aporte Propio (CARGA AJAX LAZY LOADING)
      / -------------------------------------------------------------
      .tab-pane.fade#financiera-aporte{:role => "tabpanel", "aria-labelledby" => "financiera-aporte-tab"}
        - if @actividad_x_linea.present?
          - @actividad_x_linea.each do |actividad|
            - plan_act = detalles_hash[actividad.id.to_i] || map_planes_by_act_id[actividad.id.to_i] || map_planes_by_id[actividad.id.to_i]
            - act_id_num = actividad.id.to_i
            - plan_act_id_num = plan_act.try(:id).to_i
            - mis_ids = [act_id_num, plan_act_id_num].reject(&:zero?).uniq
            
            - es_reitimizada = (mis_ids & reitimizadas_ids).any?
            - tipo_act_val = actividad.try(:tipo_actividad)
            - tipo_act_txt = (tipo_act_val.to_s == '0') ? 'Tipo A' : ((tipo_act_val.to_s == '1') ? 'Tipo B' : nil)

            - duracion_act = plan_act.try(:duracion).to_s
            - es_pendiente_previo = mis_ids.any? { |id| actividades_no_realizadas_previas.include?(id) }
            - docs_act = (@documentos_aporte || []).select { |d| d.rendicion_detalle_actividades_fpl.any? { |rda| mis_ids.include?(rda.plan_actividad_id.to_i) || mis_ids.include?(get_act_id.call(rda.plan_actividad_id.to_i)) } }

            .card.mb-2.actividad-aporte-block{id: "aporte_actividad_card_#{actividad.id}", 'data-duracion' => duracion_act, 'data-pendiente-previo' => es_pendiente_previo.to_s, style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                  - if tipo_act_txt.present?
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #17a2b8; color: #ffffff;", title: "Tipo de Actividad"}
                      = tipo_act_txt
                  - if es_reitimizada
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #6f42c1; color: #ffffff;", title: "Actividad Reitimizada Autorizada"}
                      %i.fa.fa-refresh.mr-1
                      Reitemización autorizada
                %a.btn.btn-sm.btn-outline-info.collapsed{"data-toggle" => "collapse", href: "#collapse_aporte_#{actividad.id}", role: "button", "aria-expanded" => "false", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse{id: "collapse_aporte_#{actividad.id}"}
                .card-body.p-2
                  -# CONTENEDOR AJAX PARA CARGA BAJO DEMANDA AL DESPLEGAR
                  .contenedor-desglose-ajax{id: "container_aporte_#{actividad.id}", data: { url: cargar_desglose_actividad_fondo_produccion_limpia_path(@tarea_pendiente, actividad_id: actividad.id, tipo: 'aporte', mes_a_rendir: mes_seleccionado_defecto, es_reitimizada: es_reitimizada.to_s, es_editable: es_editable.to_s), cargado: "false" }}
                    .text-center.py-3.text-muted
                      %i.fa.fa-spinner.fa-spin.mr-1
                      Cargando detalle de recursos y gastos...

                  .d-flex.justify-content-end.mb-2
                    - if es_editable
                      %button.btn.btn-sm.btn-primary{type: "button", onclick: "agregarFilaDocumentoActividad('filas-aporte-#{actividad.id}', #{actividad.id})"}
                        %i.fa.fa-plus.mr-1
                        Agregar documento

                  .table-responsive
                    %table.table.table-striped.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 35%;'} Archivos Cargados
                          - if es_editable
                            %th.encabezado-form{style: 'width: 55%;'}
                              Subir Documento Rendición
                              %span.text-danger *
                            %th.encabezado-form{style: 'width: 10%;'} Acciones
                      %tbody{id: "filas-aporte-#{actividad.id}"}
                        - if docs_act.present?
                          - docs_act.each do |doc|
                            - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                            - row_key = doc.id
                            %tr
                              %td.contenido-form
                                = hidden_field_tag "documentos_aporte[#{row_key}][id]", doc.id
                                = hidden_field_tag "documentos_aporte[#{row_key}][actividad_ids][]", actividad.id
                                = hidden_field_tag "documentos_aporte[#{row_key}][_destroy]", "0", class: "destroy-flag"
                                = __descargar_archivo_sin_titulo(archivo, doc || f.object)
                              - if es_editable
                                %td.contenido-form
                                  = file_field_tag "documentos_aporte[#{row_key}][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                                %td.contenido-form.text-center
                                  %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)", title: "Eliminar"}
                                    %i.fa.fa-trash
                        - elsif es_editable
                          - row_key = "init_aporte_#{actividad.id}"
                          %tr
                            %td.contenido-form
                              = hidden_field_tag "documentos_aporte[#{row_key}][id]", ""
                              = hidden_field_tag "documentos_aporte[#{row_key}][actividad_ids][]", actividad.id
                              = hidden_field_tag "documentos_aporte[#{row_key}][_destroy]", "0", class: "destroy-flag"
                              = '--'
                            %td.contenido-form
                              = file_field_tag "documentos_aporte[#{row_key}][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                            %td.contenido-form.text-center
                              %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)", title: "Eliminar"}
                                %i.fa.fa-trash

    -# -------------------------------------------------------------
    -# SECCIÓN: RESUMEN Y CONCLUSIONES DE LA RENDICIÓN
    -# -------------------------------------------------------------
    .card.mt-3.mb-3{style: 'border: 2px solid #dee2e6;'}
      .card-header.encabezado-form{style: 'text-align: left; padding: 10px 15px;'}
        %h5.no-margin.font-weight-bold{style: 'font-size: 14px; color: #5d759e;'}
          %i.fa.fa-file-text-o.mr-2.text-info
          Información Complementaria de la Rendición
      .card-body.p-3.border-0{style: 'border: none !important;'}
        .row
          .col-12.mb-3
            %label.label-estilo{for: 'rendicion_resultado_actividades_realizadas'}
              Resultado de las actividades realizadas
              %span.text-danger *
            = text_area_tag "rendicion[resultado_actividades_realizadas]", @rendicion&.resultado_actividades_realizadas, class: "form-control border-text", rows: 4, disabled: !es_editable, placeholder: "Describa detalladamente el resultado de las actividades realizadas...", required: true, onkeyup: "validarFormulario()", onchange: "validarFormulario()"

          .col-12.mb-3
            %label.label-estilo{for: 'rendicion_informacion_adicional'}
              Información adicional (Opcional)
            = text_area_tag "rendicion[informacion_adicional]", @rendicion&.informacion_adicional, class: "form-control border-text", rows: 2, disabled: !es_editable, placeholder: "Ingrese cualquier información adicional relevante (opcional)..."

          .col-12.mb-1
            %label.label-estilo{for: 'rendicion_conclusion'}
              Conclusión
              %span.text-danger *
            = text_area_tag "rendicion[conclusion]", @rendicion&.conclusion, class: "form-control border-text", rows: 3, disabled: !es_editable, placeholder: "Ingrese la conclusión general de la rendición...", required: true, onkeyup: "validarFormulario()", onchange: "validarFormulario()"
    .d-flex.justify-content-between.mt-3
      %button.btn.btn-sm.btn-secondary#btn-volver-paso1{type: "button"}
        %i.fa.fa-arrow-left.mr-1
        Volver a Selección

      .float-right
        = volver_root
        - if @rendicion.present?
          = link_to descargar_informe_actividades_fondo_produccion_limpia_path(@tarea_pendiente, mes_a_rendir: @rendicion.mes_a_rendir), class: "btn btn-sm btn-success mr-2", target: "_blank", data: { toggle: "tooltip" }, title: "Descargar Informe de Actividades en PDF" do
            %i.fa.fa-file-pdf-o.mr-1
            Descargar Informe PDF
        - if es_editable
          = button_tag "Grabar", 
            type: 'submit', 
            name: 'commit_type', 
            value: 'grabar', 
            id: 'grabar-button', 
            class: "btn btn-sm btn-primary mr-2", 
            data: { disable_with: "<i class='fa fa-spinner fa-spin'></i> Guardando..." }

          = button_tag t(:enviar), 
            type: 'submit', 
            name: 'commit_type', 
            value: 'enviar', 
            id: 'enviar-button', 
            class: "btn btn-sm btn-success btn-disabled", 
            disabled: true, 
            data: { confirm: "¿Está seguro que desea enviar los documentos de rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando...", remote: false }

-# ==========================================================
-# MODAL EMERGENTE PARA CARGAR URL COMO ARCHIVO ANEXO
-# ==========================================================
.modal.fade#modalUrlRespaldo{tabindex: "-1", role: "dialog", aria: {hidden: "true"}}
  .modal-dialog.modal-dialog-centered{role: "document"}
    .modal-content.text-left
      .modal-header.py-2.bg-light
        %h6.modal-title.font-weight-bold.text-secondary{style: "font-size: 14px;"}
          %i.fa.fa-link.mr-1.text-primary
          Agregar URL como archivo anexo
        %button.close{type: "button", data: {dismiss: "modal"}, aria: {label: "Cerrar"}}
          %span{aria: {hidden: "true"}} &times;
      .modal-body.p-3
        %input#modal_url_actividad_id{type: "hidden", value: ""}
        %p.text-muted{style: "font-size: 12px;"}
          Ingrese una URL como archivo anexo y añada una descripción que la identifique. Puedes cargar una URL pública o privada. En este último caso, asegúrate que quienes reciban el anexo tengan los accesos pertinentes.
        .form-group.mb-3
          %label.font-weight-bold.text-secondary{style: "font-size: 12px;"} URL:
          %input.form-control.border-text#modal_input_url{type: "url", placeholder: "Escriba la URL", style: "font-size: 13px;"}
        .form-group.mb-0
          %label.font-weight-bold.text-secondary{style: "font-size: 12px;"} Descripción:
          %input.form-control.border-text#modal_input_url_descripcion{type: "text", placeholder: "Escriba la descripción", style: "font-size: 13px;"}
      .modal-footer.py-2.px-3.bg-light
        %button.btn.btn-sm.btn-outline-secondary{type: "button", data: {dismiss: "modal"}}
          Cancelar
        %button.btn.btn-sm.btn-primary{type: "button", style: "min-width: 100px;", onclick: "guardarUrlModal()"}
          Adjuntar