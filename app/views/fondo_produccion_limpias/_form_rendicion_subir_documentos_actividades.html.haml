- fpl_objeto = @fondo_produccion_limpia || FondoProduccionLimpia.new
- titulo t(:rendicion_por_actividad)

-# -------------------------------------------------------------
-# 1. INICIALIZACIÓN DE VARIABLES Y EVALUACIÓN DE EDITABILIDAD
-# -------------------------------------------------------------
- rendiciones_todas = RendicionFpl.where(flujo_id: @tarea_pendiente&.flujo_id).includes(rendicion_detalles_fpl: :rendicion_detalle_actividades_fpl, rendicion_gastos_fpl: []).to_a rescue []
- get_estado_num = lambda { |r| (r.read_attribute_before_type_cast(:estado) || r.estado).to_i }

- estado_rend_actual = @rendicion ? get_estado_num.call(@rendicion) : 0
- es_borrador_o_observada = @rendicion.nil? || [0, 3, 4].include?(estado_rend_actual)
- es_editable = @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1 && es_borrador_o_observada

- paso_actual = params[:paso].to_s == '2' ? 2 : 1

-# MAPEO EXCLUSIVO DEL FLUJO ACTUAL PARA EVITAR FILTRADO DE OTROS PROYECTOS
- arr_planes = PlanActividad.where(flujo_id: @tarea_pendiente&.flujo_id).to_a rescue []
- map_planes_by_id = arr_planes.index_by(&:id)
- map_planes_by_act_id = arr_planes.select { |p| p.try(:actividad_id).to_i > 0 }.index_by { |p| p.actividad_id.to_i }
- detalles_hash = (@actividad_detalle.presence || arr_planes).index_by { |d| (d.try(:actividad_id).presence || d.id).to_i } rescue {}

-# ==========================================================
-# IDENTIFICADOR AISLADO DE ACTIVIDADES REITIMIZADAS
-# ==========================================================
- reitimizadas_ids = arr_planes.select { |p| [true, 'true', '1', 1, 't'].include?(p.autorizado) || p.try(:archivo_reitimizacion).to_s.present? }.flat_map { |p| [p.actividad_id.to_i, p.id.to_i] }.compact.reject(&:zero?).uniq

- valor_duracion = @duracion.presence || (@duracion_meses.respond_to?(:duracion) ? @duracion_meses.duracion : fpl_objeto.try(:duracion))
- duracion = (valor_duracion.present? && valor_duracion.to_i > 0) ? valor_duracion.to_i : 12
- mes_seleccionado_defecto = params[:mes_a_rendir].presence || @rendicion.try(:mes_a_rendir).presence || 1
- es_sin_movimientos = ['1', 'true', true, 1].include?(@rendicion.try(:sin_movimientos)) || params[:sin_movimientos].to_s == '1'

-# ==========================================================
-# CÁLCULO Y CONTROL DE GASTOS DE ADMINISTRACIÓN TOTAL (LÍMITE 10%)
-# ==========================================================
- c_costos_obj = PlanActividad.costos(@tarea_pendiente&.flujo_id) rescue nil
- tot_gen_proyecto = c_costos_obj.try(:costo_total_de_la_propuesta).to_f
- if tot_gen_proyecto.zero? && arr_planes.present?
  - tot_gen_proyecto = arr_planes.sum { |p| p.try(:valor_hh_tipo_3).to_f + p.try(:valor_hh_tipos_1_2).to_f + p.try(:total_gastos_tipo_1).to_f + p.try(:total_gastos_tipo_2).to_f }

- if c_costos_obj.present?
  - tot_admin_proyecto = c_costos_obj.try(:aporte_solicitado_fondo_gasto_administracion).to_f + c_costos_obj.try(:aporte_propio_valorado_gasto_administracion).to_f + c_costos_obj.try(:aporte_propio_liquido_gasto_administracion).to_f
- else
  - tot_admin_proyecto = arr_planes.sum { |p| p.try(:total_gastos_tipo_2).to_f }

- pct_admin_actual = tot_gen_proyecto > 0 ? (tot_admin_proyecto / tot_gen_proyecto * 100.0) : 0.0
- excede_admin = pct_admin_actual.round(1) > 10.0
- limite_admin_monto = tot_gen_proyecto * 0.10

-# Explicitación inteligente de observaciones activas (Solo detalles con cumple en estado 2 u 0)
- obs_tecnica = nil
- obs_financiera_fpl = nil
- obs_financiera_aporte = nil

- if @rendicion.present? && @rendicion.respond_to?(:rendicion_detalles_fpl)
  - detalles_activos = @rendicion.rendicion_detalles_fpl.to_a
  
  - det_tec = detalles_activos.find { |d| (d.read_attribute_before_type_cast(:tipo_tab) || d.tipo_tab).to_i == 0 }
  - if det_tec.present?
    - raw_c = (det_tec.read_attribute_before_type_cast(:cumple) || det_tec.cumple).to_s.downcase
    - if ['2', '0', 'false', 'no'].include?(raw_c)
      - obs_tecnica = det_tec.try(:comentario_revisor).presence || det_tec.try(:observacion_revisor).presence || det_tec.try(:observacion).presence || det_tec.try(:comentario).presence

  - det_fin_fpl = detalles_activos.find { |d| (d.read_attribute_before_type_cast(:tipo_tab) || d.tipo_tab).to_i == 1 }
  - if det_fin_fpl.present?
    - raw_c = (det_fin_fpl.read_attribute_before_type_cast(:cumple) || det_fin_fpl.cumple).to_s.downcase
    - if ['2', '0', 'false', 'no'].include?(raw_c)
      - obs_financiera_fpl = det_fin_fpl.try(:comentario_revisor).presence || det_fin_fpl.try(:observacion_revisor).presence || det_fin_fpl.try(:observacion).presence || det_fin_fpl.try(:comentario).presence

  - det_fin_aporte = detalles_activos.find { |d| (d.read_attribute_before_type_cast(:tipo_tab) || d.tipo_tab).to_i == 2 }
  - if det_fin_aporte.present?
    - raw_c = (det_fin_aporte.read_attribute_before_type_cast(:cumple) || det_fin_aporte.cumple).to_s.downcase
    - if ['2', '0', 'false', 'no'].include?(raw_c)
      - obs_financiera_aporte = det_fin_aporte.try(:comentario_revisor).presence || det_fin_aporte.try(:observacion_revisor).presence || det_fin_aporte.try(:observacion).presence || det_fin_aporte.try(:comentario).presence

- fecha_res = fpl_objeto.try(:fecha_resolucion)
- mes_nombre = nil
- if fecha_res.present?
  - fecha_target = fecha_res.to_date + (mes_seleccionado_defecto.to_i - 1).months
  - mes_nombre = (I18n.l(fecha_target, format: '%B %Y') rescue fecha_target.strftime('%B %Y')).capitalize
- texto_mes_display = mes_nombre.present? ? "#{mes_nombre} (Rendición #{mes_seleccionado_defecto})" : "Rendición #{mes_seleccionado_defecto}"

-# TRADUCTOR VISTA
- get_act_id = lambda { |db_id| plan = map_planes_by_id[db_id.to_i]; plan.try(:actividad_id).to_i > 0 ? plan.actividad_id.to_i : db_id.to_i }

-# LÓGICA DE ESTADOS Y EVALUACIÓN DEL MES ACTUAL CON TRADUCCIÓN
- rendiciones_en_proceso = rendiciones_todas.select { |r| r.mes_a_rendir.to_i == mes_seleccionado_defecto.to_i && [1, 2].include?(get_estado_num.call(r)) }
- act_ids_en_proceso = rendiciones_en_proceso.flat_map { |r| r.rendicion_detalles_fpl.flat_map { |d| d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) } + r.rendicion_gastos_fpl.map(&:plan_actividad_id) }.compact.map(&get_act_id).uniq

- rendiciones_observadas = rendiciones_todas.select { |r| r.mes_a_rendir.to_i == mes_seleccionado_defecto.to_i && [3, 4].include?(get_estado_num.call(r)) }
- act_ids_observadas = es_sin_movimientos ? [] : rendiciones_observadas.flat_map { |r| r.rendicion_detalles_fpl.flat_map { |d| d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) } + r.rendicion_gastos_fpl.map(&:plan_actividad_id) }.compact.map(&get_act_id).uniq

- rendiciones_borrador = rendiciones_todas.select { |r| r.mes_a_rendir.to_i == mes_seleccionado_defecto.to_i && get_estado_num.call(r) == 0 }
- act_ids_borrador = es_sin_movimientos ? [] : rendiciones_borrador.flat_map { |r| r.rendicion_detalles_fpl.flat_map { |d| d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) } + r.rendicion_gastos_fpl.map(&:plan_actividad_id) }.compact.map(&get_act_id).uniq

- act_ids_editables_actuales = (act_ids_borrador + act_ids_observadas).uniq

- rendiciones_previas = rendiciones_todas.select { |r| r.mes_a_rendir.to_i < mes_seleccionado_defecto.to_i }
- act_det_previas = rendiciones_previas.flat_map(&:rendicion_detalles_fpl).flat_map { |d| d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) }
- actividades_no_realizadas_previas = act_det_previas.compact.map(&get_act_id).uniq

- avances_aprobados_por_actividad  = Hash.new(0)
- avances_proceso_por_actividad    = Hash.new(0)
- avances_observados_por_actividad = Hash.new(0)
- avances_borrador_por_actividad   = Hash.new(0)

- rendiciones_todas.each do |rend|
  - est_num = get_estado_num.call(rend)
  - rend.rendicion_detalles_fpl.each do |det|
    - next unless (det.tecnica? rescue det.tipo_tab.to_i == 0)
    - val_av = det.nivel_avance.to_i
    - det.rendicion_detalle_actividades_fpl.each do |rda|
      - t_id = get_act_id.call(rda.plan_actividad_id)
      - avances_aprobados_por_actividad[t_id]  = [avances_aprobados_por_actividad[t_id], val_av].max if [5, 6].include?(est_num)
      - avances_proceso_por_actividad[t_id]    = [avances_proceso_por_actividad[t_id], val_av].max if [1, 2].include?(est_num)
      - avances_observados_por_actividad[t_id] = [avances_observados_por_actividad[t_id], val_av].max if [3, 4].include?(est_num)
      - avances_borrador_por_actividad[t_id]   = [avances_borrador_por_actividad[t_id], val_av].max if est_num == 0

-# Overlay de carga inicial y navegación
#pantalla-cargando{style: "position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(255, 255, 255, 0.85); z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center;"}
  %i.fa.fa-spinner.fa-spin.fa-3x.text-primary.mb-3
  %h5.font-weight-bold.text-secondary Cargando datos de rendición...

:javascript
  const ES_EDITABLE = #{es_editable ? 'true' : 'false'};
  const PASO_ACTUAL = #{paso_actual.to_i};
  const ACTIVIDADES_GUARDADAS = #{raw act_ids_editables_actuales.map(&:to_s).to_json};

  // FUNCIONES PARA MANEJO DE MODAL DE URL / ENLACE
  function abrirModalUrl(actividadId) {
    $('#modal_url_actividad_id').val(actividadId);
    const urlActual = $('#url_rendicion_' + actividadId).val() || '';
    const descActual = $('#url_descripcion_' + actividadId).val() || '';
    $('#modal_input_url').val(urlActual);
    $('#modal_input_url_descripcion').val(descActual);
    $('#modalUrlRespaldo').modal('show');
  }

  function guardarUrlModal() {
    const actId = $('#modal_url_actividad_id').val();
    const url = $('#modal_input_url').val().trim();
    const desc = $('#modal_input_url_descripcion').val().trim() || url;

    if (url === '') {
      alert('Por favor ingrese una URL válida.');
      return;
    }

    // EXCLUSIVIDAD MUTUA: Si se ingresa una URL, se limpia el archivo local adjunto
    const fileInput = $('#archivo_rendicion_' + actId);
    if (fileInput.length) {
      fileInput.val('');
      fileInput.css({ 'border': '', 'background-color': '' });
      fileInput.closest('td').find('.mensaje-archivo-listo').remove();
    }

    $('#url_rendicion_' + actId).val(url);
    $('#url_descripcion_' + actId).val(desc);

    const $preview = $('#preview_url_' + actId);
    $preview.html(`
      <div class="url-badge-container mt-2">
        <i class="fa fa-link text-info mr-1"></i>
        <a href="${url}" target="_blank" class="url-badge-link" title="${url}">
          ${desc}
        </a>
        <button type="button" class="btn-remove-url" onclick="eliminarUrl('${actId}')" title="Eliminar URL">
          <i class="fa fa-times"></i>
        </button>
      </div>
    `);

    $('#archivo_cargado_actividad_' + actId).attr('data-tiene-archivo', 'true');
    $('#modalUrlRespaldo').modal('hide');

    if (typeof validarFormulario === 'function') {
      validarFormulario();
    }
  }

  function eliminarUrl(actId) {
    $('#url_rendicion_' + actId).val('');
    $('#url_descripcion_' + actId).val('');
    $('#preview_url_' + actId).empty();

    const fileInput = document.getElementById('archivo_rendicion_' + actId);
    const tieneFile = fileInput && fileInput.files && fileInput.files.length > 0;
    const tieneArchivoDB = $('#archivo_cargado_actividad_' + actId).find('a').length > 0;

    if (!tieneFile && !tieneArchivoDB) {
      $('#archivo_cargado_actividad_' + actId).attr('data-tiene-archivo', 'false');
    }

    if (typeof validarFormulario === 'function') {
      validarFormulario();
    }
  }

  $(document).ready(function() {

    // Oculta la pantalla de carga inicial
    $(window).on('load', function() {
      $('#pantalla-cargando').fadeOut(200);
    });

    // Feedback visual al cambiar de paso
    $('#btn-continuar-paso2, #btn-volver-paso1').on('click', function() {
      $('#pantalla-cargando').find('h5').text('Procesando paso...');
      $('#pantalla-cargando').fadeIn(100);
      setTimeout(function() {
        $('#pantalla-cargando').fadeOut(200);
      }, 300);
    });

    // CARGA LAZY LOADING AL DESPLEGAR EL ACORDEÓN DE CADA ACTIVIDAD
    $(document).on('show.bs.collapse', '.collapse', function () {
      const $container = $(this).find('.contenedor-desglose-ajax');
      
      if ($container.length > 0 && $container.attr('data-cargado') === 'false') {
        const urlTarget = $container.data('url');
        
        $.ajax({
          url: urlTarget,
          type: 'GET',
          dataType: 'html',
          success: function(responseHtml) {
            $container.html(responseHtml);
            $container.attr('data-cargado', 'true');
            
            if (typeof aplicarMascarasGlobales === 'function') {
              aplicarMascarasGlobales();
            }
            if (typeof validarFormulario === 'function') {
              validarFormulario();
            }
          },
          error: function(xhr, status, error) {
            console.error("Error AJAX Desglose:", status, error, xhr.responseText);
            $container.html('<div class="alert alert-danger py-2 my-2 font-weight-bold" style="font-size: 11px;"><i class="fa fa-exclamation-circle mr-1"></i> Error al cargar el detalle de la actividad. Intente desplegar nuevamente.</div>');
          }
        });
      }
    });

    $("input:file").on('change', function () {
      const input = $(this);
      const celda = input.closest('td');

      celda.find('.mensaje-archivo-listo').remove();

      if (this.files && this.files.length > 0) {
        const nombreArchivo = this.files[0].name;

        // EXCLUSIVIDAD MUTUA: Si se adjunta archivo local, se limpia la URL registrada
        const inputId = input.attr('id') || '';
        if (inputId.includes('archivo_rendicion_')) {
          const actId = inputId.replace('archivo_rendicion_', '');
          $('#url_rendicion_' + actId).val('');
          $('#url_descripcion_' + actId).val('');
          $('#preview_url_' + actId).empty();
        }

        input.css({
          'border': '2px solid #28a745',
          'background-color': '#e8f5e9'
        });

        const mensajeHtml = `
          <div class="mensaje-archivo-listo text-success mt-1" style="font-size: 10px; font-weight: bold; line-height: 1.2;">
            <i class="fa fa-check-circle mr-1"></i> Archivo listo para adjuntar<br>
          </div>
        `;
        input.after(mensajeHtml);
      } else {
        input.css({ 'border': '', 'background-color': '' });
      }

      validarFormulario();
    });

    htmlErrorToTooltip('top');

    // VALIDACIÓN DE MONTO RENDIDO MAXIMO CUANDO NO ES REITIMIZADA
    $(document).on('input change', '.input-monto-rendido', function() {
      const $input = $(this);
      const esReitimizada = $input.data('es-reitimizada') === true || $input.data('es-reitimizada') === 'true';
      const maxPermitido = parseFloat($input.data('monto-maximo') || $input.attr('max') || 0);
      const valorIngresado = parseFloat($input.val() || 0);

      if (!esReitimizada && maxPermitido > 0 && valorIngresado > maxPermitido) {
        $input.addClass('is-invalid has-exceso-error');
        if ($input.next('.error-max-monto').length === 0) {
          $input.after(`<small class="error-max-monto text-danger d-block font-weight-bold" style="font-size: 10px;">No puede superar el monto presupuestado ($${maxPermitido.toLocaleString('es-CL')})</small>`);
        }
      } else {
        $input.removeClass('is-invalid has-exceso-error');
        $input.next('.error-max-monto').remove();
      }

      validarFormulario();
    });

    $('#chk_sin_movimientos_paso1').on('change', function() {
      const esSinMovimientos = $(this).is(':checked');
      $('#hdn_sin_movimientos').val(esSinMovimientos ? '1' : '0');

      if (esSinMovimientos) {
        $('.chk-actividad-paso1').prop('checked', false).prop('disabled', true);
      } else if (ES_EDITABLE) {
        const esUltima = $('#chk_ultima_rendicion_paso1').is(':checked');
        if (esUltima) {
          actualizarComportamientoUltimaRendicion(true);
        } else {
          $('.chk-actividad-paso1').each(function() {
            const permDisabled = $(this).data('permanente-disabled') === true || $(this).data('permanente-disabled') === 'true';
            if (!permDisabled) {
              $(this).prop('disabled', false);
              const debeMarcar = $(this).data('debe-marcar-defecto') === true || $(this).data('debe-marcar-defecto') === 'true';
              if (debeMarcar) {
                $(this).prop('checked', true);
              }
            }
          });
        }
      }
      filtrarVistaPorSeleccion(obtenerActividadesSeleccionadas());
      validarFormulario();
    });

    $('#chk_ultima_rendicion_paso1').on('change', function() {
      const esUltima = $(this).is(':checked');
      $('#chk_ultima_rendicion_form').prop('checked', esUltima);
      actualizarComportamientoUltimaRendicion(esUltima);
    });

    $('#chk_ultima_rendicion_form').on('change', function() {
      const esUltima = $(this).is(':checked');
      $('#chk_ultima_rendicion_paso1').prop('checked', esUltima);
      actualizarComportamientoUltimaRendicion(esUltima);
    });

    if ($('#chk_sin_movimientos_paso1').is(':checked')) {
      $('#chk_sin_movimientos_paso1').trigger('change');
    } else if ($('#chk_ultima_rendicion_paso1').is(':checked')) {
      actualizarComportamientoUltimaRendicion(true);
    } else {
      if (PASO_ACTUAL === 2 && ACTIVIDADES_GUARDADAS.length > 0) {
        filtrarVistaPorSeleccion(ACTIVIDADES_GUARDADAS);
      } else {
        const seleccionadasIniciales = obtenerActividadesSeleccionadas();
        filtrarVistaPorSeleccion(seleccionadasIniciales);
      }
    }

    $('#btn-continuar-paso2').on('click', function() {
      const esSinMovimientos = $('#chk_sin_movimientos_paso1').is(':checked');
      const seleccionadas = obtenerActividadesSeleccionadas();

      if (!esSinMovimientos && seleccionadas.length === 0) {
        alert('Debe seleccionar al menos una actividad para rendir o marcar la opción "Sin movimientos".');
        return;
      }

      $('#paso1_resumen').hide();
      $('#paso2_formulario').fadeIn();
      filtrarVistaPorSeleccion(seleccionadas);
    });

    $('#btn-volver-paso1').on('click', function() {
      $('#paso2_formulario').hide();
      $('#paso1_resumen').fadeIn();
    });

    $('form').on('submit', function() {
      const seleccionadas = obtenerActividadesSeleccionadas();
      $('#hdn_actividades_seleccionadas').val(seleccionadas.join(','));
    });

    if (!ES_EDITABLE) {
      bloquearFormularioSoloLectura();
    }
  });

  function actualizarComportamientoUltimaRendicion(esUltima) {
    const esSinMovimientos = $('#chk_sin_movimientos_paso1').is(':checked');
    if (!ES_EDITABLE || esSinMovimientos) return;

    $('.chk-actividad-paso1').each(function() {
      const permDisabled = $(this).data('permanente-disabled') === true || $(this).data('permanente-disabled') === 'true';

      if (!permDisabled) {
        if (esUltima) {
          $(this).prop('checked', true).prop('disabled', true);
        } else {
          $(this).prop('disabled', false);
          const debeMarcar = $(this).data('debe-marcar-defecto') === true || $(this).data('debe-marcar-defecto') === 'true';
          $(this).prop('checked', debeMarcar);
        }
      }
    });

    filtrarVistaPorSeleccion(obtenerActividadesSeleccionadas());
    validarFormulario();
  }

  function obtenerActividadesSeleccionadas() {
    const seleccionadas = [];
    $('.chk-actividad-paso1:checked').each(function() {
      seleccionadas.push($(this).val().toString());
    });
    return seleccionadas;
  }

  function filtrarVistaPorSeleccion(actividadesIds) {
    const esSinMovimientos = $('#chk_sin_movimientos_paso1').is(':checked');

    $('.actividad-tecnica-block, .actividad-fpl-block, .actividad-aporte-block').each(function() {
      const id = $(this).attr('id').replace('tecnica_actividad_card_', '').replace('fpl_actividad_card_', '').replace('aporte_actividad_card_', '');
      
      if (!esSinMovimientos && actividadesIds.includes(id)) {
        $(this).show();
        $(this).find('input, select, textarea').prop('disabled', false);
      } else {
        $(this).hide();
        $(this).find('input, select, textarea').prop('disabled', true);
      }
    });

    validarFormulario();
  }

  function toggleObservacion(selectElement, actividadId) {
    validarFormulario();
  }

  function bloquearFormularioSoloLectura() {
    $('#paso1_resumen input[type="checkbox"], #paso2_formulario input[type="checkbox"]').prop('disabled', true);
    $('#paso2_formulario select, #paso2_formulario textarea, #paso2_formulario input[type="file"], #paso2_formulario input[type="date"]').prop('disabled', true);
    $('.btn-outline-danger, button[onclick*="agregarFilaDocumentoActividad"]').hide().prop('disabled', true);
    $('#grabar-button, #enviar-button').prop('disabled', true).addClass('btn-disabled');
  }

  function validarFormulario() {
    if (!ES_EDITABLE) {
      bloquearFormularioSoloLectura();
      return;
    }

    const esSinMovimientos = $('#chk_sin_movimientos_paso1').is(':checked');
    const pendientes = [];

    let tabTecnicaValido = true;
    let tieneActividadesTecnicas = false;

    if (!esSinMovimientos) {
      document.querySelectorAll('.actividad-tecnica-block').forEach(block => {
        if (block.style.display === 'none') return;
        tieneActividadesTecnicas = true;

        const id = block.id.replace('tecnica_actividad_card_', '');
        const selectRealizada = document.getElementById('realizada_actividad_' + id);
        const observacionInput = document.getElementById('observacion_actividad_' + id);
        const fechaInicioInput = document.getElementById('fecha_inicio_actividad_' + id);
        const fechaTerminoInput = document.getElementById('fecha_termino_actividad_' + id);
        const fileInput = document.getElementById('archivo_rendicion_' + id);
        const urlInput = document.getElementById('url_rendicion_' + id);
        const tdArchivo = document.getElementById('archivo_cargado_actividad_' + id);
        const actNombre = $(block).find('.header-actividad-fpl .font-weight-bold').text().trim() || ('Actividad ' + id);

        if (selectRealizada && tdArchivo) {
          const realizada = selectRealizada.value.trim();
          const observacion = observacionInput ? observacionInput.value.trim() : '';
          const fechaInicio = fechaInicioInput ? fechaInicioInput.value.trim() : '';
          const fechaTermino = fechaTerminoInput ? fechaTerminoInput.value.trim() : '';
          const tieneArchivoPrevio = tdArchivo.getAttribute('data-tiene-archivo') === 'true';
          const tieneArchivoNuevo = fileInput && fileInput.files && fileInput.files.length > 0;
          const tieneUrlInput = urlInput && urlInput.value.trim() !== '';
          const tieneArchivo = tieneArchivoPrevio || tieneArchivoNuevo || tieneUrlInput;
          let resumenValido = true;
          const inputResultado = document.getElementById('rendicion_resultado_actividades_realizadas');
          const inputConclusion = document.getElementById('rendicion_conclusion');

          if (inputResultado) {
            if (inputResultado.value.trim() === '') {
              resumenValido = false;
              $(inputResultado).addClass('is-invalid');
            } else {
              $(inputResultado).removeClass('is-invalid');
            }
          }

          if (inputConclusion) {
            if (inputConclusion.value.trim() === '') {
              resumenValido = false;
              $(inputConclusion).addClass('is-invalid');
            } else {
              $(inputConclusion).removeClass('is-invalid');
            }
          }

          if (fechaInicio === '') {
            tabTecnicaValido = false;
            $(fechaInicioInput).addClass('is-invalid');
            pendientes.push('<b>Pestaña Técnica [' + actNombre + ']:</b> Ingresar Fecha de Inicio.');
          } else {
            $(fechaInicioInput).removeClass('is-invalid');
          }

          if (fechaTermino === '') {
            tabTecnicaValido = false;
            $(fechaTerminoInput).addClass('is-invalid');
            pendientes.push('<b>Pestaña Técnica [' + actNombre + ']:</b> Ingresar Fecha de Término.');
          } else {
            $(fechaTerminoInput).removeClass('is-invalid');
          }

          if (realizada === '') {
            tabTecnicaValido = false;
            $(selectRealizada).addClass('is-invalid');
            pendientes.push('<b>Pestaña Técnica [' + actNombre + ']:</b> Seleccionar Nivel de Avance.');
          } else {
            $(selectRealizada).removeClass('is-invalid');
          }

          if (observacion === '') {
            tabTecnicaValido = false;
            $(observacionInput).addClass('is-invalid');
            pendientes.push('<b>Pestaña Técnica [' + actNombre + ']:</b> Ingresar Descripción del Avance.');
          } else {
            $(observacionInput).removeClass('is-invalid');
          }

          if (!tieneArchivo) {
            tabTecnicaValido = false;
            if (fileInput) $(fileInput).addClass('is-invalid');
            pendientes.push('<b>Pestaña Técnica [' + actNombre + ']:</b> Adjuntar Documento de Respaldo Técnico o URL.');
          } else {
            if (fileInput) $(fileInput).removeClass('is-invalid');
          }
        }
      });

      if (!tieneActividadesTecnicas) {
        tabTecnicaValido = false;
        pendientes.push('<b>Pestaña Técnica:</b> No se han seleccionado actividades para rendir.');
      }
    }

    let tabFinancieraFplValido = true;

    if (!esSinMovimientos) {
      document.querySelectorAll('.actividad-fpl-block').forEach(block => {
        if (block.style.display === 'none') return;
        const actNombre = $(block).find('.header-actividad-fpl .font-weight-bold').text().trim() || 'FPL';

        let tieneDocEnBlock = false;
        block.querySelectorAll('tbody tr').forEach(fila => {
          if (fila.style.display === 'none') return;
          const destroyFlag = fila.querySelector('input.destroy-flag');
          if (destroyFlag && destroyFlag.value === '1') return;

          const fileInput = fila.querySelector('input[type="file"]');
          const tdArchivoPrevio = fila.querySelector('td');
          const tieneArchivoNuevo = fileInput && fileInput.files && fileInput.files.length > 0;
          const tieneArchivoPrevio = tdArchivoPrevio && tdArchivoPrevio.querySelector('a') !== null;

          if (tieneArchivoNuevo || tieneArchivoPrevio) {
            tieneDocEnBlock = true;
            if (fileInput) $(fileInput).removeClass('is-invalid');
          } else if (fileInput) {
            $(fileInput).addClass('is-invalid');
          }
        });

        if (!tieneDocEnBlock) {
          tabFinancieraFplValido = false;
          pendientes.push('<b>Pestaña Financiera FPL [' + actNombre + ']:</b> Adjuntar Documento de Rendición.');
        }
      });
    }

    let tabFinancieraAporteValido = true;

    if (!esSinMovimientos) {
      document.querySelectorAll('.actividad-aporte-block').forEach(block => {
        if (block.style.display === 'none') return;
        const actNombre = $(block).find('.header-actividad-fpl .font-weight-bold').text().trim() || 'Aporte Propio';

        let tieneDocEnBlock = false;
        block.querySelectorAll('tbody tr').forEach(fila => {
          if (fila.style.display === 'none') return;
          const destroyFlag = fila.querySelector('input.destroy-flag');
          if (destroyFlag && destroyFlag.value === '1') return;

          const fileInput = fila.querySelector('input[type="file"]');
          const tdArchivoPrevio = fila.querySelector('td');
          const tieneArchivoNuevo = fileInput && fileInput.files && fileInput.files.length > 0;
          const tieneArchivoPrevio = tdArchivoPrevio && tdArchivoPrevio.querySelector('a') !== null;

          if (tieneArchivoNuevo || tieneArchivoPrevio) {
            tieneDocEnBlock = true;
            if (fileInput) $(fileInput).removeClass('is-invalid');
          } else if (fileInput) {
            $(fileInput).addClass('is-invalid');
          }
        });

        if (!tieneDocEnBlock) {
          tabFinancieraAporteValido = false;
          pendientes.push('<b>Pestaña Financiera Aporte [' + actNombre + ']:</b> Adjuntar Documento de Rendición.');
        }
      });
    }

    let resumenValido = true;
    const inputResultado = document.getElementById('rendicion_resultado_actividades_realizadas');
    const inputConclusion = document.getElementById('rendicion_conclusion');

    if (inputResultado && inputResultado.value.trim() === '') {
      resumenValido = false;
    }
    if (inputConclusion && inputConclusion.value.trim() === '') {
      resumenValido = false;
    }

    const tieneExcesoMonto = $('.has-exceso-error').length > 0;
    const formCompleto = esSinMovimientos ? resumenValido : (tabTecnicaValido && tabFinancieraFplValido && tabFinancieraAporteValido && resumenValido && !tieneExcesoMonto);
    const botonEnviar = document.getElementById('enviar-button');
    
    if (botonEnviar) {
      botonEnviar.disabled = !formCompleto;
      if (formCompleto) {
        botonEnviar.classList.remove('btn-disabled');
      } else {
        botonEnviar.classList.add('btn-disabled');
      }
    }
  }

  function agregarFilaDocumentoActividad(tbodyId, actividadId) {
    if (!ES_EDITABLE) return;
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;

    const timestamp = Date.now() + Math.floor(Math.random() * 1000);
    const esFpl = tbodyId.includes('filas-fpl');
    const paramName = esFpl ? 'documentos_fpl' : 'documentos_aporte';

    const nuevaFilaHtml = `
      <tr>
        <td class="contenido-form">
          <input type="hidden" name="${paramName}[${timestamp}][id]" value="" />
          <input type="hidden" name="${paramName}[${timestamp}][actividad_ids][]" value="${actividadId}" />
          <input type="hidden" name="${paramName}[${timestamp}][_destroy]" value="0" class="destroy-flag" />
          --
        </td>
        <td class="contenido-form">
          <input type="file" name="${paramName}[${timestamp}][archivo]" class="form-control smaller-text border-text" onchange="validarFormulario()" />
        </td>
        <td class="contenido-form text-center">
          <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarFilaDocumento(this)" title="Eliminar">
            <i class="fa fa-trash"></i>
          </button>
        </td>
      </tr>
    `;

    $(tbody).append(nuevaFilaHtml);
    validarFormulario();
  }

  function eliminarFilaDocumento(boton) {
    if (!ES_EDITABLE) return;
    const $tr = $(boton).closest('tr');
    const hiddenId = $tr.find('input[type="hidden"][name*="[id]"]').val();

    if (hiddenId && hiddenId !== '') {
      $tr.find('input.destroy-flag').val('1');
      $tr.hide();
    } else {
      const $tbody = $tr.closest('tbody');
      if ($tbody.find('tr:visible').length > 1) {
        $tr.remove();
      } else {
        $tr.find('input[type="file"]').val('');
        $tr.find('input[type="hidden"][name*="[id]"]').val('');
      }
    }
    validarFormulario();
  }

  // Lógica para mostrar la sección Información Complementaria solo en la pestaña "tecnica"
  $(document).ready(function() {
    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
      if ($(e.target).attr('href') === '#tecnica') {
        $('#info-complementaria-section').show();
      } else {
        $('#info-complementaria-section').hide();
      }
    });

    // Validar estado inicial
    if ($('#tecnica').hasClass('active')) {
      $('#info-complementaria-section').show();
    } else {
      $('#info-complementaria-section').hide();
    }
  });

