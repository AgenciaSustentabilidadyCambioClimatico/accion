      - else
        .card.mt-2
          .card-body.text-center.text-muted No hay actividades configuradas.

  .float-right.mt-3
    = volver_root
    - if (@tiene_permisos.nil? || @tiene_permisos) && @tarea_pendiente.estado_tarea_pendiente_id == 1
      = button_tag "Grabar", 
        type: 'submit', 
        name: 'commit_type', 
        value: 'grabar', 
        id: 'grabar-button', 
        class: "btn btn-sm btn-primary mr-2", 
        data: { disable_with: "<i class='fa fa-spinner fa-spin'></i> Grabando..." }

      = button_tag t(:enviar), 
        type: 'submit', 
        name: 'commit_type', 
        value: 'enviar', 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success btn-disabled", 
        disabled: true, 
        data: { confirm: "¿Está seguro que desea enviar las correcciones de rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando...", remote: false }

/ ----------------------------------------------------
/ MODAL POPUP: BITÁCORA DEL POSTULANTE
/ ----------------------------------------------------
.modal.fade#modalBitacoraComentarios{tabindex: "-1", role: "dialog", "aria-labelledby" => "modalBitacoraLabel", "aria-hidden" => "true"}
  .modal-dialog.modal-lg{role: "document"}
    .modal-content
      .modal-header.bg-info.text-white
        %h5.modal-title#modalBitacoraLabel
          %i.fa.fa-comments.mr-2
          %span#modalBitacoraLabelText Bitácora de Observaciones y Comentarios
        %button.close.text-white{type: "button", "data-dismiss" => "modal", "aria-label" => "Cerrar"}
          %span{"aria-hidden" => "true"} &times;
      .modal-body
        .alert.alert-secondary.py-2.mb-3
          %strong Actividad:
          %span#modal_titulo_actividad.font-italic

        #bitacora_historial_container.mb-3{style: "max-height: 250px; overflow-y: auto;"}

        #seccion_nuevo_comentario
          %hr
          .form-group.mb-0
            %label.font-weight-bold.text-primary{for: "nuevo_comentario_modal"}
              %i.fa.fa-pencil.mr-1
              Agregar Respuesta / Comentario del Postulante:
            %textarea#nuevo_comentario_modal.form-control.border-text{rows: 3, placeholder: "Escriba aquí sus comentarios o aclaraciones..."}

      .modal-footer
        %button.btn.btn-sm.btn-secondary#btn_cerrar_modal{type: "button", "data-dismiss" => "modal"} Cancelar
        %button.btn.btn-sm.btn-primary#btn_guardar_modal{type: "button", onclick: "guardarComentarioModal()"}
          %i.fa.fa-plus-circle.mr-1
          Añadir Entrada a Bitácora