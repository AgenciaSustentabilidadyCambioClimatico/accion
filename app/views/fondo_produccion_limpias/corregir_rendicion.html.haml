:javascript
  $(document).ready(function() {
    $('.chosen-control').chosen({
      allow_single_deselect: true,
      no_results_text: 'No se encontraron resultados',
      width: '100%'
    }).change(function() {
      validarFormulario();
    });

    $("input:file").on('change', function () {
      $(this).parent().siblings("label").html($(this)[0].files[0].name);
      validarFormulario();
    });

    htmlErrorToTooltip('top');

    // Filtrar al cargar según el mes fijo
    filtrarPorMes();
  });

  function filtrarPorMes() {
    const mesSeleccionado = $('#mes_a_rendir').val() ? $('#mes_a_rendir').val().toString().trim() : '';

    if (!mesSeleccionado || mesSeleccionado === '') {
      return;
    }

    // 1. Filtrar filas de la Pestaña Técnica
    $('tr[id^="fila_actividad_"]').each(function() {
      const duracionAttr = $(this).attr('data-duracion');
      if (duracionAttr && duracionAttr.trim() !== '') {
        const mesesValidos = duracionAttr.split(',').map(function(m) { return m.trim(); });
        if (mesesValidos.indexOf(mesSeleccionado) !== -1) {
          $(this).show();
        } else {
          $(this).hide();
        }
      } else {
        $(this).hide();
      }
    });

    // 2. Filtrar opciones de los Chosen en Financiera FPL y Aporte
    $('#filas-documentos-fpl select, #filas-documentos-aporte select').each(function() {
      const $select = $(this);
      $select.find('option').each(function() {
        const valOpt = $(this).val();
        if (!valOpt || valOpt === '') return;

        const duracionOpt = $(this).attr('data-duracion');
        if (duracionOpt && duracionOpt.trim() !== '') {
          const mesesOpt = duracionOpt.split(',').map(function(m) { return m.trim(); });
          if (mesesOpt.indexOf(mesSeleccionado) !== -1) {
            $(this).prop('disabled', false);
          } else {
            $(this).prop('disabled', true);
            $(this).prop('selected', false);
          }
        } else {
          $(this).prop('disabled', true);
          $(this).prop('selected', false);
        }
      });
      $select.trigger('chosen:updated');
    });

    validarFormulario();
  }

  function guardarYActualizar(event, nombreCampo, origen) {
    guardarArchivos(event, nombreCampo, origen);
    validarFormulario();
  }

  function guardarArchivos(event, nombreCampo, origen) {
    const archivoInput = document.getElementById(nombreCampo);
    if (!archivoInput || !archivoInput.files[0]) return;

    const archivo = archivoInput.files[0];
    const formData = new FormData();
    formData.append('archivo', archivo);
    formData.append('nombre_campo', nombreCampo);

    const Id = "#{@tarea_pendiente.nil? ? '' : @tarea_pendiente.id}";
    formData.append('id', Id);

    fetch('/subir_documento_refresh_pagina', {
      method: 'POST',
      body: formData,
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      }
    })
    .then(async response => {
      const text = await response.text();
      try {
        const data = JSON.parse(text);
      } catch {
        eval(text);
      }
    })
    .catch(error => {
      console.error("Error al subir archivo:", error);
    });
  }

  function toggleObservacion(selectElement, actividadId) {
    const obsInput = document.getElementById('observacion_actividad_' + actividadId);
    if (obsInput) {
      if (selectElement.value.toLowerCase() === 'no') {
        obsInput.disabled = false;
      } else {
        obsInput.disabled = true;
        obsInput.value = '';
      }
    }
    validarFormulario();
  }

  function validarFormulario() {
    let formCompleto = true;

    // Validación según pestaña visible
    const esTecnica = $('#tecnica').hasClass('active') || $('#tecnica').hasClass('show');

    if (esTecnica) {
      document.querySelectorAll('tr[id^="fila_actividad_"]').forEach(fila => {
        if (fila.style.display === 'none') return;

        const id = fila.id.split('_').pop();
        const selectRealizada = document.getElementById('realizada_actividad_' + id);
        const observacionInput = document.getElementById('observacion_actividad_' + id);
        const fileInput = document.getElementById('archivo_rendicion_' + id);
        const tdArchivo = document.getElementById('archivo_cargado_actividad_' + id);

        if (selectRealizada && tdArchivo) {
          const realizada = selectRealizada.value.toLowerCase();
          const observacion = observacionInput ? observacionInput.value.trim() : '';
          const tieneArchivoPrevio = tdArchivo.getAttribute('data-tiene-archivo') === 'true';
          const tieneArchivoNuevo = fileInput && fileInput.files.length > 0;

          if (realizada === 'si') {
            if (!tieneArchivoPrevio && !tieneArchivoNuevo) formCompleto = false;
          } else if (realizada === 'no') {
            if (observacion === '') formCompleto = false;
          } else {
            formCompleto = false;
          }
        }
      });
    }

    const botonEnviar = document.getElementById('enviar-button');
    if (botonEnviar) {
      botonEnviar.disabled = !formCompleto;
      if (formCompleto) {
        botonEnviar.classList.remove('btn-disabled');
      } else {
        botonEnviar.classList.add('btn-disabled');
      }
    }
  }

  function agregarFilaDocumento(tablaId) {
    const tbody = document.getElementById(tablaId);
    $('#' + tablaId + ' .chosen-control').chosen('destroy');

    const primeraFila = tbody.querySelector('tr');
    const nuevaFila = primeraFila.cloneNode(true);

    // 1. Resetear la etiqueta de ID poniéndola en blanco en lugar de eliminarla
    nuevaFila.querySelectorAll('input[type="hidden"][name*="[id]"]').forEach(el => el.value = '');

    // 2. Limpiar inputs de archivo
    nuevaFila.querySelectorAll('input[type="file"]').forEach(el => el.value = '');

    // 3. Limpiar textareas o campos de texto
    nuevaFila.querySelectorAll('textarea, input[type="text"]').forEach(el => el.value = '');

    // 4. Deseleccionar opciones en los selects
    nuevaFila.querySelectorAll('select').forEach(select => {
      Array.from(select.options).forEach(opt => opt.selected = false);
    });

    // 5. Limpiar celdas visuales de descargas u observaciones previas
    const celdas = nuevaFila.querySelectorAll('td');
    if (celdas[0]) celdas[0].innerHTML = '--';
    if (celdas[1]) celdas[1].innerHTML = '<div class="p-2 bg-light border rounded smaller-text text-muted">Sin observaciones</div>';

    tbody.appendChild(nuevaFila);

    $('.chosen-control').chosen({
      allow_single_deselect: true,
      no_results_text: 'No se encontraron resultados',
      width: '100%'
    }).change(function() {
      validarFormulario();
    });

    filtrarPorMes();
  }

  function eliminarFilaDocumento(boton) {
    const tbody = boton.closest('tbody');
    if (tbody.querySelectorAll('tr').length > 1) {
      boton.closest('tr').remove();
      validarFormulario();
    } else {
      alert('Debe mantener al menos una fila de documento.');
    }
  }

:css
  .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table { width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; }
  .table tbody + tbody { border-top: 2px solid #dee2e6; }
  .table .table { background-color: #fff; }
  .table thead th { font-size: 12px; border: 2px solid #dee2e6; }
  .encabezado-form { vertical-align: middle; background-color: #E0EFF6; text-align: center; font-weight: bold; }
  .contenido-form { border: 2px solid #dee2e6; font-size: 12px; vertical-align: top; background-color: #fff; color: #5d759e; }
  .smaller-text { font-size: 11px !important; height: auto !important; padding: 2px 4px !important; }
  .border-text { border: 1px solid #cccccc; border-radius: 4px; background-color: #ffffff; }
  #financiera-fpl .card, #financiera-aporte .card { min-height: auto !important; overflow: visible !important; }
  #financiera-fpl .card-body, #financiera-aporte .card-body { min-height: auto !important; overflow: visible !important; padding-bottom: 15px !important; }
  #financiera-fpl .table-responsive, #financiera-aporte .table-responsive, #tabla-financiera-fpl, #tabla-financiera-aporte, #tabla-financiera-fpl tr, #tabla-financiera-aporte tr, #tabla-financiera-fpl td, #tabla-financiera-aporte td { overflow: visible !important; }
  .chosen-container .chosen-drop { z-index: 9999 !important; position: absolute !important; }
  #tabla-financiera-fpl td, #tabla-financiera-aporte td { vertical-align: middle; padding: 8px; }
  .box-mes-a-rendir { background-color: #e9ecef; border: 1px solid #ced4da; border-radius: 4px; padding: 6px 12px; font-weight: bold; color: #495057; display: inline-block; }

- fpl_objeto = @fondo_produccion_limpia || FondoProduccionLimpia.new  
- titulo t(:rendicion_por_actividad)
- mes_guardado = @rendicion.try(:mes_a_rendir)

-# Consulta directa de las duraciones desde plan_actividades
- planes_hash = PlanActividad.where(flujo_id: @tarea_pendiente&.flujo_id).index_by(&:actividad_id) rescue {}

-# Mapeo de opciones de actividades
- opciones_actividades_select = (@actividad_x_linea || []).map do |a|
  - plan = planes_hash[a.id]
  - dur_val = plan ? plan.duracion.to_s : ''
  - [ "#{a.correlativo} - #{a.nombre}", a.id, { 'data-duracion' => dur_val } ]

.row
  .col-12
    .card.mb-3
      .card-header.p-0
        .p-3
          %h5.no-margin= titulo_instrumento_fpl.html_safe
          %h5.no-margin= titulo_instrumento.html_safe
          %h5.no-margin= titulo_proyecto_fpl.html_safe
          %h5.no-margin= titulo_apl.html_safe
          %h5.no-margin= datos_beneficiario_fpl.html_safe

-# Definición de Pestañas según el tipo de tarea (FPL-17 o FPL-18)
- tabs = {}
- if @es_correccion_tecnica
  - tabs['tecnica'] = true
- else
  - tabs['financiera-fpl'] = true
  - tabs['financiera-aporte'] = false

#tab-menu-controls.mb-0.mt-3.px-2{:role => "tabpanel"}
  %ul#manifestacion.nav.nav-tabs{:role => "tablist"}
    - tabs.each do |tab, active|
      %li.nav-item.tab-block{id: "#{tab}-tab"}
        %a.nav-link.tab-block{id: "#{tab}-tab", class: (:active if active), "aria-controls" => tab, "aria-expanded" => "true", "data-toggle" => "tab", :href => "##{tab}", :role => "tab"}
          = t(tab.to_s.gsub('-','_'))

- url_post = @es_correccion_tecnica ? guardar_correccion_tecnica_rendicion_fondo_produccion_limpia_path(@tarea_pendiente) : guardar_correccion_financiera_rendicion_fondo_produccion_limpia_path(@tarea_pendiente)

= simple_form_for fpl_objeto, url: url_post, html: { multipart: true, autocomplete: :off }, remote: true do |f|
  = hidden_field_tag "mes_a_rendir", mes_guardado, id: "mes_a_rendir"

  .tab-content#manifestacionContent
    - if @es_correccion_tecnica
      -# Pestaña 1: Corrección Técnica (FPL-18)
      .tab-pane.fade.show.active#tecnica{:role => "tabpanel", "aria-labelledby" => "tecnica-tab"}
        .card
          .card-header
            %h5.no-margin Corrección Técnica de Rendición
          .card-body
            .row.mb-3
              .col-md-4.col-sm-6
                .box-mes-a-rendir= "Mes en corrección: Mes #{mes_guardado || '--'}"

            .table-responsive
              %table.table.table-striped.usuarios.no-margin
                %thead
                  %tr
                    %th.encabezado-form{style: 'width: 5%;'}= t(:n°)
                    %th.encabezado-form{style: 'width: 25%;'}= t(:actividades)
                    %th.encabezado-form{style: 'width: 8%;'} Realizada
                    %th.encabezado-form{style: 'width: 20%;'} Observación del Revisor
                    %th.encabezado-form{style: 'width: 12%;'} Archivos Cargados
                    - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                      %th.encabezado-form{style: 'width: 15%;'}= t(:subir_documento_rendicion)
                    %th.encabezado-form{style: 'width: 15%;'} Observación del Postulante
                %tbody
                  - if @actividad_x_linea.present?
                    - @actividad_x_linea.each do |actividad|
                      = hidden_field_tag "actividades_ids[]", actividad.id
                      - plan = planes_hash[actividad.id]
                      - duracion_act = plan ? plan.duracion.to_s : ''
                      - detalle_tecnico = @rendicion&.rendicion_detalles_fpl&.find { |d| d.tecnica? && d.plan_actividades.map(&:id).include?(actividad.id) }
                      - realizada_valor = detalle_tecnico.nil? ? '' : (detalle_tecnico.realizada? ? 'si' : 'no')
                      - observacion_valor = detalle_tecnico&.observacion
                      - comentario_revisor_val = detalle_tecnico&.comentario_revisor
                      - archivo = detalle_tecnico&.archivo
                      - tiene_archivo = detalle_tecnico&.archivo&.url.present?

                      %tr{id: "fila_actividad_#{actividad.id}", 'data-duracion' => duracion_act}
                        %td.contenido-form{style: 'text-align: center;'}= actividad.correlativo
                        %td.contenido-form= actividad.nombre
                        %td.contenido-form
                          = select_tag "realizada_actividad_#{actividad.id}", options_from_collection_for_select([['Seleccione...', ''], ['Sí', 'si'], ['No', 'no']], :last, :first, realizada_valor), class: "form-control smaller-text border-text", onchange: "toggleObservacion(this, '#{actividad.id}')"
                        %td.contenido-form
                          .p-2.bg-light.border.rounded.smaller-text.text-danger.font-weight-bold
                            = comentario_revisor_val.presence || 'Sin observaciones'
                        %td.contenido-form{id: "archivo_cargado_actividad_#{actividad.id}", data: { tiene_archivo: tiene_archivo.to_s }}
                          = __descargar_archivo_sin_titulo(archivo, detalle_tecnico || f.object)
                        - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                          %td.contenido-form
                            = file_field_tag "archivo_rendicion_#{actividad.id}", id: "archivo_rendicion_#{actividad.id}", class: "form-control smaller-text border-text", onchange: "guardarYActualizar(event, 'archivo_rendicion_#{actividad.id}', 'rendicion');"
                        %td.contenido-form
                          = text_area_tag "observacion_actividad_#{actividad.id}", observacion_valor, id: "observacion_actividad_#{actividad.id}", class: "form-control smaller-text border-text", placeholder: "Ingrese o complemente observación (optativo)...", rows: 2, onkeyup: "validarFormulario()"
    - else
      -# Pestaña 2: Corrección Financiera FPL (FPL-17)
      .tab-pane.fade.show.active#financiera-fpl{:role => "tabpanel", "aria-labelledby" => "financiera-fpl-tab"}
        .card{style: 'overflow: visible;'}
          .card-header.d-flex.justify-content-between.align-items-center
            %h5.no-margin Documentos de Rendición Financiera FPL
            .box-mes-a-rendir= "Mes en corrección: Mes #{mes_guardado || '--'}"
            - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
              %button.btn.btn-sm.btn-primary{type: "button", onclick: "agregarFilaDocumento('filas-documentos-fpl')"}
                %i.fa.fa-plus
                Agregar documento

          .card-body{style: 'overflow: visible; padding-bottom: 15px;'}
            .table-responsive{style: 'overflow: visible;'}
              %table.table.table-striped.no-margin#tabla-financiera-fpl
                %thead
                  %tr
                    %th.encabezado-form{style: 'width: 15%;'} Archivos Cargados
                    %th.encabezado-form{style: 'width: 25%;'} Observación / Comentario Revisor
                    %th.encabezado-form{style: 'width: 20%;'} Documento Rendición (Nuevo / Reemplazo)
                    %th.encabezado-form{style: 'width: 20%;'} Actividad Relacionada
                    %th.encabezado-form{style: 'width: 15%;'} Observación Postulante (Optativo)
                    - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                      %th.encabezado-form{style: 'width: 5%;'} Acciones
                %tbody#filas-documentos-fpl
                  - if @documentos_fpl.present?
                    - @documentos_fpl.each do |doc|
                      - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                      - act_ids = doc.plan_actividades.pluck(:id)
                      - comentario_revisor_val = doc.comentario_revisor
                      - observacion_postulante_val = doc.try(:observacion)
                      %tr
                        = hidden_field_tag "documentos_fpl[][id]", doc.id
                        %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                        %td.contenido-form
                          .p-2.bg-light.border.rounded.smaller-text.text-danger.font-weight-bold
                            = comentario_revisor_val.presence || 'Sin observaciones'
                        %td.contenido-form= file_field_tag "documentos_fpl[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                        %td.contenido-form{style: 'overflow: visible;'}
                          = select_tag "documentos_fpl[][actividad_ids][]", options_for_select(opciones_actividades_select, act_ids), multiple: true, class: "form-control chosen-control", data: { placeholder: "Seleccione actividades..." }
                        %td.contenido-form
                          = text_area_tag "documentos_fpl[][observacion]", observacion_postulante_val, class: "form-control smaller-text border-text", placeholder: "Respuesta u observación (optativo)...", rows: 2
                        - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                          %td.contenido-form.text-center
                            %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)"}
                              %i.fa.fa-trash
                  - else
                    %tr
                      = hidden_field_tag "documentos_fpl[][id]", ""
                      %td.contenido-form= __descargar_archivo_sin_titulo(nil, f.object)
                      %td.contenido-form
                        .p-2.bg-light.border.rounded.smaller-text.text-muted Sin observaciones
                      %td.contenido-form= file_field_tag "documentos_fpl[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                      %td.contenido-form{style: 'overflow: visible;'}
                        = select_tag "documentos_fpl[][actividad_ids][]", options_for_select(opciones_actividades_select), multiple: true, class: "form-control chosen-control", data: { placeholder: "Seleccione actividades..." }
                      %td.contenido-form
                        = text_area_tag "documentos_fpl[][observacion]", nil, class: "form-control smaller-text border-text", placeholder: "Respuesta u observación (optativo)...", rows: 2
                      - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                        %td.contenido-form.text-center
                          %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)"}
                            %i.fa.fa-trash

      -# Pestaña 3: Corrección Financiera Aporte (FPL-17)
      .tab-pane.fade#financiera-aporte{:role => "tabpanel", "aria-labelledby" => "financiera-aporte-tab"}
        .card{style: 'overflow: visible;'}
          .card-header.d-flex.justify-content-between.align-items-center
            %h5.no-margin Documentos de Rendición Financiera Aporte
            .box-mes-a-rendir= "Mes en corrección: Mes #{mes_guardado || '--'}"
            - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
              %button.btn.btn-sm.btn-primary{type: "button", onclick: "agregarFilaDocumento('filas-documentos-aporte')"}
                %i.fa.fa-plus
                Agregar documento

          .card-body{style: 'overflow: visible; padding-bottom: 15px;'}
            .table-responsive{style: 'overflow: visible;'}
              %table.table.table-striped.no-margin#tabla-financiera-aporte
                %thead
                  %tr
                    %th.encabezado-form{style: 'width: 15%;'} Archivos Cargados
                    %th.encabezado-form{style: 'width: 25%;'} Observación / Comentario Revisor
                    %th.encabezado-form{style: 'width: 20%;'} Documento Rendición (Nuevo / Reemplazo)
                    %th.encabezado-form{style: 'width: 20%;'} Actividad Relacionada
                    %th.encabezado-form{style: 'width: 15%;'} Observación Postulante (Optativo)
                    - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                      %th.encabezado-form{style: 'width: 5%;'} Acciones
                %tbody#filas-documentos-aporte
                  - if @documentos_aporte.present?
                    - @documentos_aporte.each do |doc|
                      - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                      - act_ids = doc.plan_actividades.pluck(:id)
                      - comentario_revisor_val = doc.comentario_revisor
                      - observacion_postulante_val = doc.try(:observacion)
                      %tr
                        = hidden_field_tag "documentos_aporte[][id]", doc.id
                        %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                        %td.contenido-form
                          .p-2.bg-light.border.rounded.smaller-text.text-danger.font-weight-bold
                            = comentario_revisor_val.presence || 'Sin observaciones'
                        %td.contenido-form= file_field_tag "documentos_aporte[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                        %td.contenido-form{style: 'overflow: visible;'}
                          = select_tag "documentos_aporte[][actividad_ids][]", options_for_select(opciones_actividades_select, act_ids), multiple: true, class: "form-control chosen-control", data: { placeholder: "Seleccione actividades..." }
                        %td.contenido-form
                          = text_area_tag "documentos_aporte[][observacion]", observacion_postulante_val, class: "form-control smaller-text border-text", placeholder: "Respuesta u observación (optativo)...", rows: 2
                        - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                          %td.contenido-form.text-center
                            %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)"}
                              %i.fa.fa-trash
                  - else
                    %tr
                      = hidden_field_tag "documentos_aporte[][id]", ""
                      %td.contenido-form= __descargar_archivo_sin_titulo(nil, f.object)
                      %td.contenido-form
                        .p-2.bg-light.border.rounded.smaller-text.text-muted Sin observaciones
                      %td.contenido-form= file_field_tag "documentos_aporte[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                      %td.contenido-form{style: 'overflow: visible;'}
                        = select_tag "documentos_aporte[][actividad_ids][]", options_for_select(opciones_actividades_select), multiple: true, class: "form-control chosen-control", data: { placeholder: "Seleccione actividades..." }
                      %td.contenido-form
                        = text_area_tag "documentos_aporte[][observacion]", nil, class: "form-control smaller-text border-text", placeholder: "Respuesta u observación (optativo)...", rows: 2
                      - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
                        %td.contenido-form.text-center
                          %button.btn.btn-sm.btn-outline-danger{type: "button", onclick: "eliminarFilaDocumento(this)"}
                            %i.fa.fa-trash

  .float-right.mt-3
    = volver_root
    - if @tiene_permisos && @tarea_pendiente.estado_tarea_pendiente_id == 1
      = button_tag "Grabar", 
        type: 'submit', 
        name: 'commit_type', 
        value: 'grabar', 
        id: 'grabar-button', 
        class: "btn btn-sm btn-primary mr-2", 
        data: { disable_with: "<i class='fa fa-spinner fa-spin'></i> Grabando..." }

      = button_tag t(:enviar), 
        type: 'submit', 
        name: 'commit_type', 
        value: 'enviar', 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success btn-disabled", 
        disabled: true, 
        data: { confirm: "¿Está seguro que desea enviar las correcciones de rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando...", remote: false }