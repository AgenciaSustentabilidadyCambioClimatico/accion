            .card.mb-3.actividad-aporte-block{id: "aporte_actividad_card_#{actividad.id}", style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                %a.btn.btn-sm.btn-outline-info{"data-toggle" => "collapse", href: "#collapse_aporte_corr_#{actividad.id}", role: "button", "aria-expanded" => "true", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse.show{id: "collapse_aporte_corr_#{actividad.id}"}
                .card-body.p-2
                  = render 'tabla_desglose_gastos_actividad', gastos: gastos_aporte, actividad_id: actividad.id, es_editable: (!@es_correccion_tecnica && @tiene_permisos != false)

                  - if !@es_correccion_tecnica
                    .table-responsive.mt-3
                      %table.table.table-striped.usuarios.no-margin
                        %thead
                          %tr
                            %th.encabezado-form{style: 'width: 25%;'} Archivos Cargados
                            %th.encabezado-form{style: 'width: 35%;'} Documento Rendición (Nuevo / Reemplazo)
                            %th.encabezado-form{style: 'width: 40%;'} Observación Postulante
                        %tbody
                          - if docs_act.present?
                            - docs_act.each do |doc|
                              - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                              - comentario_revisor_val = doc.comentario_revisor
                              - comentario_postulante_val = doc.try(:comentario_postulante)
                              - num_comentarios_post = comentario_postulante_val.to_s.split("\n").reject(&:blank?).count

                              %tr
                                = hidden_field_tag "documentos_aporte[][id]", doc.id
                                = hidden_field_tag "documentos_aporte[][actividad_ids][]", actividad.id
                                %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                                %td.contenido-form= file_field_tag "documentos_aporte[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                                %td.contenido-form.text-center
                                  = hidden_field_tag "comentario_revisor_aporte_#{doc.id}", comentario_revisor_val, id: "comentario_revisor_aporte_#{doc.id}"
                                  = hidden_field_tag "documentos_aporte_obs_#{doc.id}", comentario_postulante_val, id: "documentos_aporte_obs_#{doc.id}", name: "documentos_aporte[][comentario_postulante]"
                                  
                                  %button.btn.btn-sm.btn-primary.w-100{type: 'button', onclick: "abrirModalComentarios('#{doc.id}', '#{j actividad.nombre}', 'documentos_aporte_obs_', 'comentario_revisor_aporte_', false)"}
                                    %i.fa.fa-comments.mr-1
                                    Bitácora
                                  .mt-1{id: "preview_documentos_aporte_obs_#{doc.id}"}
                                    %span.badge{class: num_comentarios_post > 0 ? 'badge-info' : 'badge-secondary'}
                                      %i.fa.fa-comments
                                      = "#{num_comentarios_post} registro(s)"
                          - else
                            %tr
                              = hidden_field_tag "documentos_aporte[][id]", ""
                              = hidden_field_tag "documentos_aporte[][actividad_ids][]", actividad.id
                              %td.contenido-form.text-muted Sin documentos cargados
                              %td.contenido-form= file_field_tag "documentos_aporte[][archivo]", class: "form-control smaller-text border-text", onchange: "validarFormulario()"
                              %td.contenido-form.text-center
                                = hidden_field_tag "comentario_revisor_aporte_act_#{actividad.id}", nil, id: "comentario_revisor_aporte_act_#{actividad.id}"
                                = hidden_field_tag "documentos_aporte_obs_act_#{actividad.id}", nil, id: "documentos_aporte_obs_act_#{actividad.id}", name: "documentos_aporte[][comentario_postulante]"
                                %button.btn.btn-sm.btn-primary.w-100{type: 'button', onclick: "abrirModalComentarios('act_#{actividad.id}', '#{j actividad.nombre}', 'documentos_aporte_obs_', 'comentario_revisor_aporte_act_', false)"}
                                  %i.fa.fa-comments.mr-1
                                  Bitácora
                                .mt-1{id: "preview_documentos_aporte_obs_act_#{actividad.id}"}
                                  %span.badge.badge-secondary 0 registro(s)
                  - else
                    .table-responsive.mt-2
                      %table.table.table-striped.no-margin
                        %thead
                          %tr
                            %th.encabezado-form{style: 'width: 100%;'} Archivos Cargados
                        %tbody
                          - if docs_act.present?
                            - docs_act.each do |doc|
                              - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                              %tr
                                %td.contenido-form
                                  = __descargar_archivo_sin_titulo(archivo, doc || f.object)
