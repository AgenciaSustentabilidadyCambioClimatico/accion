:javascript
  $(document).ready(function() {
    $('.chosen-control').chosen({
      allow_single_deselect: true,
      no_results_text: 'No se encontraron resultados',
      width: '100%'
    }).change(function() {
      validarFormulario();
    });

    $("input:file").on('change', function () {
      $(this).parent().siblings("label").html($(this)[0].files[0].name);
      validarFormulario();
    });

    htmlErrorToTooltip('top');
    validarFormulario();
  });

  // ----------------------------------------------------
  // LÓGICA DE BITÁCORA UNIFICADA (POSTULANTE Y REVISOR)
  // ----------------------------------------------------
  function abrirModalComentarios(id, tituloActividad, idInputRevisor, idInputPostulante, esSoloLectura = true) {
    const targetInputId = idInputRevisor + id;
    const targetPostulanteId = idInputPostulante + id;

    $('#modalBitacoraComentarios').attr('data-target-input', targetInputId);
    $('#modal_titulo_actividad').text(tituloActividad);

    const inputRevisor = document.getElementById(targetInputId);
    const inputPostulante = document.getElementById(targetPostulanteId);

    const textoRevisor = inputRevisor ? inputRevisor.value : '';
    const textoPostulante = inputPostulante ? inputPostulante.value : '';

    $('#bitacora_historial_container').html(formatearBitacoraDoble(textoPostulante, textoRevisor));
    $('#nuevo_comentario_modal').val('');

    if (esSoloLectura) {
      $('#seccion_nuevo_comentario').hide();
      $('#btn_guardar_modal').hide();
      $('#btn_cerrar_modal').text('Cerrar');
    } else {
      $('#seccion_nuevo_comentario').show();
      $('#btn_guardar_modal').show();
      $('#btn_cerrar_modal').text('Cancelar');
    }

    $('#modalBitacoraComentarios').modal('show');
  }

  function formatearBitacoraDoble(textoPostulante, textoRevisor) {
    let html = '';

    if (textoPostulante && textoPostulante.trim() !== '') {
      html += '<div class="font-weight-bold text-primary mb-1"><i class="fa fa-user mr-1"></i> Comentarios / Observaciones del Postulante:</div>';
      textoPostulante.split('\n').forEach(linea => {
        if (linea.trim() !== '') {
          html += '<div class="p-2 mb-2 bg-info text-white border rounded smaller-text">' + escapeHtml(linea) + '</div>';
        }
      });
    }

    if (textoRevisor && textoRevisor.trim() !== '') {
      html += '<div class="font-weight-bold text-danger mt-2 mb-1"><i class="fa fa-user-md mr-1"></i> Historial del Revisor:</div>';
      textoRevisor.split('\n').forEach(linea => {
        if (linea.trim() !== '') {
          html += '<div class="p-2 mb-2 bg-light border border-danger text-dark rounded smaller-text">' + escapeHtml(linea) + '</div>';
        }
      });
    }

    if (html === '') {
      html = '<div class="text-muted font-italic p-3 text-center border rounded bg-light">No hay registros previos en la bitácora.</div>';
    }

    return html;
  }

  function contarLineasComentarios(texto) {
    if (!texto) return 0;
    return texto.split('\n').filter(linea => linea.trim() !== '').length;
  }

  function escapeHtml(text) {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  function validarFormulario() {
    let formularioValido = true;
    const botonEnviar = document.getElementById('enviar-button');
    if (botonEnviar) {
      botonEnviar.disabled = !formularioValido;
    }
  }

:css
  .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table { width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; }
  .table tbody + tbody { border-top: 2px solid #dee2e6; }
  .table .table { background-color: #fff; }
  .table thead th { font-size: 12px; border: 2px solid #dee2e6; }
  .encabezado-form { vertical-align: middle; background-color: #E0EFF6; text-align: center; font-weight: bold; }
  .contenido-form { border: 2px solid #dee2e6; font-size: 12px; vertical-align: top; background-color: #fff; color: #5d759e; }
  .smaller-text { font-size: 11px !important; height: auto !important; padding: 2px 4px !important; }
  .border-text { border: 1px solid #cccccc; border-radius: 4px; background-color: #ffffff; }
  .label-estilo { color: #5d759e; font-weight: 400; font-size: 14px; }
  .header-actividad-fpl { background-color: #E0EFF6 !important; border: 2px solid #dee2e6 !important; padding: 8px 12px !important; color: #333 !important; font-weight: bold; }

- fpl_objeto = @fondo_produccion_limpia || FondoProduccionLimpia.new
- titulo "Verificación Contable de Rendición"

-# Obtención del mes guardado en rendiciones_fpl
- mes_actual = @rendicion&.mes_a_rendir.to_s

-# Identificar ÚNICAMENTE las actividades que forman parte de esta rendición en la BD
- actividades_en_rendicion = @rendicion&.rendicion_detalles_fpl&.flat_map { |d| d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) }&.uniq || []
- detalles_hash = (@actividad_detalle.presence || PlanActividad.where(flujo_id: @tarea_pendiente&.flujo_id)).index_by { |d| (d.try(:actividad_id).presence || d.id).to_i } rescue {}

-# -------------------------------------------------------------
-# CÁLCULO SINTÁCTICAMENTE CORRECTO DEL MES EN CURSO
-# -------------------------------------------------------------
- fecha_res = fpl_objeto.try(:fecha_resolucion)
- mes_nombre = nil
- if fecha_res.present?
  - fecha_target = fecha_res.to_date + (mes_actual.to_i - 1).months
  - mes_nombre = (I18n.l(fecha_target, format: '%B %Y') rescue fecha_target.strftime('%B %Y')).capitalize

- texto_mes_display = mes_nombre.present? ? "#{mes_nombre} (Rendición #{mes_actual})" : "Rendición #{mes_actual}"

-# Lambda auxiliar para consultar gastos por actividad
- obtener_gastos_actividad = lambda do |act_id, tipos_validos|
  - f_id = @tarea_pendiente&.flujo_id
  - rec_int = PlanActividad.recursos_internos(f_id, act_id).select { |r| tipos_validos.any? { |t| r.try(:tipo_aporte).to_s.downcase.include?(t) } } rescue []
  - rec_ext = PlanActividad.recursos_externos(f_id, act_id).select { |r| tipos_validos.any? { |t| r.try(:tipo_aporte).to_s.downcase.include?(t) } } rescue []
  - g_op    = PlanActividad.gastos_operaciones(f_id, act_id).select { |g| tipos_validos.any? { |t| g.try(:tipo_aporte).to_s.downcase.include?(t) } } rescue []
  - g_adm   = PlanActividad.gastos_administraciones(f_id, act_id).select { |g| tipos_validos.any? { |t| g.try(:tipo_aporte).to_s.downcase.include?(t) } } rescue []
  - { rrhh_propios: rec_int, rrhh_externos: rec_ext, operaciones: g_op, administracion: g_adm }

.row
  .col-12
    .card.mb-3
      .card-header.p-0
        .p-3
          %h5.no-margin= titulo_instrumento_fpl.html_safe
          %h5.no-margin= titulo_instrumento.html_safe
          %h5.no-margin= titulo_proyecto_fpl.html_safe
          %h5.no-margin= titulo_apl.html_safe
          %h5.no-margin= datos_beneficiario_fpl.html_safe

-# INDICADOR VISUAL DEL MES EN VERIFICACIÓN CONTABLE
.row.mb-3
  .col-12
    .card.border-info.mb-0{style: "border-width: 2px;"}
      .card-body.p-2.d-flex.align-items-center.justify-content-between.bg-light
        %span.font-weight-bold.text-secondary{style: "font-size: 14px;"}
          %i.fa.fa-calendar-check-o.mr-2.text-info
          Rendición correspondiente a:
        %span.badge.badge-info{style: "font-size: 14px; padding: 6px 14px;"}
          = texto_mes_display

-# Cargar todas las pestañas para revisión contable integral
- tabs = { 'tecnica' => true, 'financiera-fpl' => false, 'financiera-aporte' => false }

#tab-menu-controls.mb-0.mt-3.px-2{:role => "tabpanel"}
  %ul#manifestacion.nav.nav-tabs{:role => "tablist"}
    - tabs.each do |tab, active|
      %li.nav-item.tab-block{id: "#{tab}-tab"}
        %a.nav-link.tab-block{id: "#{tab}-tab", class: (:active if active), "aria-controls" => tab, "aria-expanded" => "true", "data-toggle" => "tab", :href => "##{tab}", :role => "tab"}
          = t(tab.to_s.gsub('-','_'))

= simple_form_for fpl_objeto, url: guardar_verificacion_contable_rendicion_fondo_produccion_limpia_path(@tarea_pendiente), html: { autocomplete: :off }, remote: true do |f|
  = hidden_field_tag "mes_a_rendir", mes_actual.presence || @rendicion&.mes_a_rendir || 1
  
  .tab-content#manifestacionContent

    -# ----------------------------------------------------
    -# Pestaña 1: Información Técnica Consolidada (NUEVA VISTA)
    -# ----------------------------------------------------
    .tab-pane.fade.show.active#tecnica{:role => "tabpanel", "aria-labelledby" => "tecnica-tab"}
      - if @actividad_x_linea.present?
        - actividades_filtradas = @actividad_x_linea.select { |a| actividades_en_rendicion.include?(a.id) }

        - if actividades_filtradas.present?
          - actividades_filtradas.each do |actividad|
            - plan_act = detalles_hash[actividad.id.to_i] || PlanActividad.find_by(id: actividad.id) || PlanActividad.find_by(flujo_id: @tarea_pendiente&.flujo_id, actividad_id: actividad.id)
            
            - obj_esp_id = plan_act.respond_to?(:attributes) ? (plan_act.attributes['objetivos_especifico_id'] || plan_act.attributes['objetivo_especifico_id']) : nil
            - obj_esp_id ||= PlanActividad.where(actividad_id: plan_act.try(:id), flujo_id: @tarea_pendiente&.flujo_id).pluck(:objetivos_especifico_id).first if plan_act.present?
            
            - obj_esp = ObjetivosEspecifico.find_by(id: obj_esp_id) if obj_esp_id.present?
            - indicador_texto = obj_esp.try(:indicadores).presence || obj_esp.try(:descripcion).presence || "Sin indicador registrado."

            - detalle_tecnico = @rendicion&.rendicion_detalles_fpl&.find { |d| is_tec = (d.tipo_tab.to_s == 'tecnica' || (d.respond_to?(:tecnica?) && d.tecnica?)); act_ids = d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) + (d.respond_to?(:plan_actividades) && d.plan_actividades.present? ? d.plan_actividades.map(&:id) : []); is_tec && act_ids.include?(actividad.id) }
            
            - duracion_act = plan_act.try(:duracion).to_s
            - fecha_inicio_valor = detalle_tecnico&.try(:fecha_inicio)&.try(:strftime, '%d-%m-%Y') || '--'
            - fecha_termino_valor = detalle_tecnico&.try(:fecha_termino)&.try(:strftime, '%d-%m-%Y') || '--'
            - nivel_avance_val = detalle_tecnico&.try(:nivel_avance).to_s
            - observacion_valor = detalle_tecnico&.observacion
            
            - comentario_postulante_val = detalle_tecnico&.try(:comentario_postulante)
            - valor_comentario = detalle_tecnico&.comentario_revisor
            - num_comentarios_rev = valor_comentario.to_s.split("\n").reject(&:blank?).count
            
            - raw_cumple = detalle_tecnico ? (detalle_tecnico.read_attribute_before_type_cast(:cumple) || detalle_tecnico.cumple) : nil
            - val_str = raw_cumple.to_s.downcase
            - es_aprobado = ['1', 'si', 'true'].include?(val_str)
            - archivo = detalle_tecnico&.archivo
            - tiene_archivo = detalle_tecnico&.archivo&.url.present?

            .card.mb-3.actividad-tecnica-block{id: "tecnica_actividad_card_#{actividad.id}", 'data-duracion' => duracion_act, style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                %a.btn.btn-sm.btn-outline-info{"data-toggle" => "collapse", href: "#collapse_tecnica_#{actividad.id}", role: "button", "aria-expanded" => "true", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse.show{id: "collapse_tecnica_#{actividad.id}"}
                .card-body.p-2
                  = hidden_field_tag "actividades_ids[]", actividad.id

                  .alert.d-flex.align-items-center.py-2.px-3.mb-2{style: "background-color: #d0e7ff; border: 1px solid #b8daff; color: #004085; border-radius: 4px; font-size: 12px;"}
                    %i.fa.fa-question-circle.mr-2{style: "font-size: 15px; color: #004085;"}
                    %span
                      %strong Indicador asociado al objetivo:
                      = indicador_texto

                  .table-responsive
                    %table.table.table-bordered.table-sm.no-margin{style: "font-size: 11px;"}
                      %thead
                        %tr.bg-light
                          %th.encabezado-form{style: 'width: 15%;'} Fecha de Inicio
                          %th.encabezado-form{style: 'width: 15%;'} Fecha de Término
                          %th.encabezado-form{style: 'width: 15%;'} Nivel de avance
                          %th.encabezado-form{style: 'width: 55%;'} Descripción del Avance
                      %tbody
                        %tr
                          %td.contenido-form.text-center= fecha_inicio_valor
                          %td.contenido-form.text-center= fecha_termino_valor
                          %td.contenido-form.text-center{style: 'vertical-align: middle !important;'}
                            - case nivel_avance_val
                            - when '0'
                              %span.badge.badge-secondary{style: 'font-size: 10px; padding: 6px 12px; display: inline-block;'} Sin iniciar
                            - when '1'
                              %span.badge.badge-warning.text-white{style: 'font-size: 10px; padding: 6px 12px; display: inline-block; background-color: #fd7e14;'} En proceso
                            - when '2'
                              %span.badge.badge-success{style: 'font-size: 10px; padding: 6px 12px; display: inline-block;'} Completado
                            - else
                              - if detalle_tecnico.present? && detalle_tecnico.try(:realizada?)
                                %span.badge.badge-success{style: 'font-size: 10px; padding: 6px 12px; display: inline-block;'} Completado
                              - else
                                %span.badge.badge-secondary{style: 'font-size: 10px; padding: 6px 12px; display: inline-block;'} Sin registrar
                          %td.contenido-form= observacion_valor.presence || '--'

                  .mt-3.mb-2.px-1
                    %h6.font-weight-bold.text-secondary{style: "font-size: 12px;"} 
                      %i.fa.fa-file-pdf-o.mr-1
                      Documento de Respaldo Técnico

                  .table-responsive
                    %table.table.table-striped.usuarios.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 50%;'} Archivos Evidencia
                          %th.encabezado-form{style: 'width: 25%;'} Eval. Técnica
                          %th.encabezado-form{style: 'width: 25%;'} Comentarios
                      %tbody
                        %tr
                          %td.contenido-form{id: "archivo_cargado_actividad_#{actividad.id}", data: { tiene_archivo: tiene_archivo.to_s }}
                            - if detalle_tecnico.present? && archivo.present?
                              = __descargar_archivo_sin_titulo(archivo, detalle_tecnico)
                            - else
                              = '--'
                          
                          %td.contenido-form.text-center{style: 'vertical-align: middle !important;'}
                            - if es_aprobado
                              %span.badge.badge-success{style: 'font-size: 10px; padding: 6px 12px;'} Cumple
                            - else
                              %span.badge.badge-danger{style: 'font-size: 10px; padding: 6px 12px;'} No Cumple

                          %td.contenido-form.text-center
                            - if detalle_tecnico.present?
                              = hidden_field_tag "comentario_postulante_#{detalle_tecnico.id}", comentario_postulante_val, id: "comentario_postulante_#{detalle_tecnico.id}"
                              = hidden_field_tag "comentario_revisor_#{detalle_tecnico.id}", valor_comentario, id: "comentario_revisor_#{detalle_tecnico.id}"
                              
                              %button.btn.btn-sm.btn-outline-primary.w-100{type: 'button', onclick: "abrirModalComentarios('#{detalle_tecnico.id}', '#{j actividad.nombre}', 'comentario_revisor_', 'comentario_postulante_', true)"}
                                %i.fa.fa-comments.mr-1
                                Bitácora
                              .mt-1{id: "preview_comentario_revisor_#{detalle_tecnico.id}"}
                                %span.badge{class: num_comentarios_rev > 0 ? 'badge-info' : 'badge-secondary'}
                                  %i.fa.fa-comments
                                  = "#{num_comentarios_rev} registro(s)"
                            - else
                              = '--'
        - else
          .card.mt-2
            .card-body.text-center.text-muted No hay actividades registradas en esta rendición.
      - else
        .card.mt-2
          .card-body.text-center.text-muted No hay actividades configuradas para esta línea.

    -# ----------------------------------------------------
    -# Pestaña 2: Información Financiera FPL
    -# ----------------------------------------------------
    .tab-pane.fade#financiera-fpl{:role => "tabpanel", "aria-labelledby" => "financiera-fpl-tab"}
      - if @actividad_x_linea.present?
        - actividades_fpl_filtradas = @actividad_x_linea.select { |a| actividades_en_rendicion.include?(a.id) }
        - docs_fpl_base = @documentos_fpl.presence || (@rendicion&.rendicion_detalles_fpl&.select { |d| (d.respond_to?(:financiera_fpl?) && d.financiera_fpl?) || d.tipo_tab.to_s.include?('fpl') || d.tipo_tab.to_s == '1' }) || []

        - if actividades_fpl_filtradas.present?
          - actividades_fpl_filtradas.each do |actividad|
            - docs_act = docs_fpl_base.select { |d| act_ids = d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) + (d.respond_to?(:plan_actividades) && d.plan_actividades.present? ? d.plan_actividades.map(&:id) : []); act_ids.include?(actividad.id) }
            - gastos_fpl = obtener_gastos_actividad.call(actividad.id, ['solicitado al fondo', 'solicitado_al_fondo'])

            .card.mb-3.actividad-fpl-block{id: "fpl_actividad_card_#{actividad.id}", style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                %a.btn.btn-sm.btn-outline-info{"data-toggle" => "collapse", href: "#collapse_fpl_audit_#{actividad.id}", role: "button", "aria-expanded" => "true", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse.show{id: "collapse_fpl_audit_#{actividad.id}"}
                .card-body.p-2
                  = render 'tabla_desglose_gastos_actividad', gastos: gastos_fpl, actividad_id: actividad.id, es_editable: false

                  .table-responsive.mt-3
                    %table.table.table-striped.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 35%;'} Archivos Cargados
                          %th.encabezado-form{style: 'width: 15%;'} Eval. Financiera
                          %th.encabezado-form{style: 'width: 50%;'} Comentarios
                      %tbody
                        - if docs_act.present?
                          - docs_act.each do |doc|
                            - raw_cumple = doc.read_attribute_before_type_cast(:cumple) || doc.cumple
                            - val_str = raw_cumple.to_s.downcase
                            - es_aprobado = ['1', 'si', 'true'].include?(val_str)
                            - valor_comentario = doc.comentario_revisor
                            - comentario_postulante_val = doc.try(:comentario_postulante)
                            - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                            - num_comentarios_rev = valor_comentario.to_s.split("\n").reject(&:blank?).count

                            %tr
                              %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                              %td.contenido-form.text-center{style: 'vertical-align: middle !important;'}
                                - if es_aprobado
                                  %span.badge.badge-success{style: 'font-size: 10px; padding: 6px 12px;'} Cumple
                                - else
                                  %span.badge.badge-danger{style: 'font-size: 10px; padding: 6px 12px;'} No Cumple
                              %td.contenido-form.text-center
                                = hidden_field_tag "comentario_postulante_#{doc.id}", comentario_postulante_val, id: "comentario_postulante_#{doc.id}"
                                = hidden_field_tag "comentario_revisor_#{doc.id}", valor_comentario, id: "comentario_revisor_#{doc.id}"
                                %button.btn.btn-sm.btn-outline-primary.w-100{type: 'button', onclick: "abrirModalComentarios('#{doc.id}', '#{j actividad.nombre}', 'comentario_revisor_', 'comentario_postulante_', true)"}
                                  %i.fa.fa-comments.mr-1
                                  Bitácora
                                .mt-1{id: "preview_comentario_revisor_#{doc.id}"}
                                  %span.badge{class: num_comentarios_rev > 0 ? 'badge-info' : 'badge-secondary'}
                                    %i.fa.fa-comments
                                    = "#{num_comentarios_rev} registro(s)"
                        - else
                          %tr
                            %td.contenido-form.text-muted.text-center Sin documentos cargados
                            %td.contenido-form.text-center --
                            %td.contenido-form.text-center --
        - else
          .card.mt-2
            .card-body.text-center.text-muted No hay documentos financieros FPL para auditar en este mes.
      - else
        .card.mt-2
          .card-body.text-center.text-muted No hay actividades configuradas.

    -# ----------------------------------------------------
    -# Pestaña 3: Información Financiera Aporte Propio
    -# ----------------------------------------------------
    .tab-pane.fade#financiera-aporte{:role => "tabpanel", "aria-labelledby" => "financiera-aporte-tab"}
      - if @actividad_x_linea.present?
        - actividades_aporte_filtradas = @actividad_x_linea.select { |a| actividades_en_rendicion.include?(a.id) }
        - docs_aporte_base = @documentos_aporte.presence || (@rendicion&.rendicion_detalles_fpl&.select { |d| (d.respond_to?(:financiera_aporte?) && d.financiera_aporte?) || d.tipo_tab.to_s.include?('aporte') || d.tipo_tab.to_s == '2' }) || []

        - if actividades_aporte_filtradas.present?
          - actividades_aporte_filtradas.each do |actividad|
            - docs_act = docs_aporte_base.select { |d| act_ids = d.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id) + (d.respond_to?(:plan_actividades) && d.plan_actividades.present? ? d.plan_actividades.map(&:id) : []); act_ids.include?(actividad.id) }
            - gastos_aporte = obtener_gastos_actividad.call(actividad.id, ['aporte propio valorado', 'aporte propio liquido', 'aporte_propio_valorado', 'aporte_propio_liquido'])

            .card.mb-3.actividad-aporte-block{id: "aporte_actividad_card_#{actividad.id}", style: "border: 2px solid #dee2e6;"}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl
                .d-flex.align-items-center
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                %a.btn.btn-sm.btn-outline-info{"data-toggle" => "collapse", href: "#collapse_aporte_audit_#{actividad.id}", role: "button", "aria-expanded" => "true", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse.show{id: "collapse_aporte_audit_#{actividad.id}"}
                .card-body.p-2
                  = render 'tabla_desglose_gastos_actividad', gastos: gastos_aporte, actividad_id: actividad.id, es_editable: false

                  .table-responsive.mt-3
                    %table.table.table-striped.no-margin
                      %thead
                        %tr
                          %th.encabezado-form{style: 'width: 35%;'} Archivos Cargados
                          %th.encabezado-form{style: 'width: 15%;'} Eval. Financiera
                          %th.encabezado-form{style: 'width: 50%;'} Comentarios
                      %tbody
                        - if docs_act.present?
                          - docs_act.each do |doc|
                            - raw_cumple = doc.read_attribute_before_type_cast(:cumple) || doc.cumple
                            - val_str = raw_cumple.to_s.downcase
                            - es_aprobado = ['1', 'si', 'true'].include?(val_str)
                            - valor_comentario = doc.comentario_revisor
                            - comentario_postulante_val = doc.try(:comentario_postulante)
                            - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                            - num_comentarios_rev = valor_comentario.to_s.split("\n").reject(&:blank?).count

                            %tr
                              %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                              %td.contenido-form.text-center{style: 'vertical-align: middle !important;'}
                                - if es_aprobado
                                  %span.badge.badge-success{style: 'font-size: 10px; padding: 6px 12px;'} Cumple
                                - else
                                  %span.badge.badge-danger{style: 'font-size: 10px; padding: 6px 12px;'} No Cumple
                              %td.contenido-form.text-center
                                = hidden_field_tag "comentario_postulante_#{doc.id}", comentario_postulante_val, id: "comentario_postulante_#{doc.id}"
                                = hidden_field_tag "comentario_revisor_#{doc.id}", valor_comentario, id: "comentario_revisor_#{doc.id}"
                                %button.btn.btn-sm.btn-outline-primary.w-100{type: 'button', onclick: "abrirModalComentarios('#{doc.id}', '#{j actividad.nombre}', 'comentario_revisor_', 'comentario_postulante_', true)"}
                                  %i.fa.fa-comments.mr-1
                                  Bitácora
                                .mt-1{id: "preview_comentario_revisor_#{doc.id}"}
                                  %span.badge{class: num_comentarios_rev > 0 ? 'badge-info' : 'badge-secondary'}
                                    %i.fa.fa-comments
                                    = "#{num_comentarios_rev} registro(s)"
                        - else
                          %tr
                            %td.contenido-form.text-muted.text-center Sin documentos cargados
                            %td.contenido-form.text-center --
                            %td.contenido-form.text-center --
        - else
          .card.mt-2
            .card-body.text-center.text-muted No hay documentos de aporte para auditar en este mes.
      - else
        .card.mt-2
          .card-body.text-center.text-muted No hay actividades configuradas.

  -# Sección de Cierre / Dictamen Contable
  .card.mt-3
    .card-header
      %h5.no-margin Dictamen de Verificación Contable
    .card-body
      .row
        .col-12
          %label.font-weight-bold Comentario de Auditoría / Verificación Contable (Optativo)
          = text_area_tag "comentario_contable", @rendicion&.try(:comentario_contable), class: "form-control border-text", rows: 3, placeholder: "Ingrese observaciones o notas de auditoría contable..."

  .float-left
    - if @rendicion.present?
      = link_to descargar_informe_gastos_fondo_produccion_limpia_path(@tarea_pendiente, mes_a_rendir: @rendicion.mes_a_rendir), class: "btn btn-sm btn-info mr-2", target: "_blank", data: { toggle: "tooltip" }, title: "Descargar Informe de Gastos PDF" do
        %i.fa.fa-file-pdf-o.mr-1
        Descargar Informe PDF
  .float-right.mt-3.mb-4  
    = volver_root   
    - if @tiene_permisos
      = button_tag "Grabar Avance", 
        type: 'submit', 
        name: 'commit_type', 
        value: 'grabar', 
        class: "btn btn-sm btn-primary mr-2", 
        data: { disable_with: "<i class='fa fa-spinner fa-spin'></i> Grabando..." }

      = button_tag "Aprobar Verificación Contable", 
        type: 'submit', 
        name: 'commit_type', 
        value: 'enviar', 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success", 
        data: { confirm: "¿Está seguro que desea dar por APROBADA la verificación contable de esta rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando..." }

/ ----------------------------------------------------
/ MODAL POPUP: BITÁCORA Y HISTORIAL DE COMENTARIOS
/ ----------------------------------------------------
.modal.fade#modalBitacoraComentarios{tabindex: "-1", role: "dialog", "aria-labelledby" => "modalBitacoraLabel", "aria-hidden" => "true"}
  .modal-dialog.modal-lg{role: "document"}
    .modal-content
      .modal-header.bg-info.text-white
        %h5.modal-title#modalBitacoraLabel
          %i.fa.fa-comments.mr-2
          %span#modalBitacoraLabelText Bitácora de Comentarios
        %button.close.text-white{type: "button", "data-dismiss" => "modal", "aria-label" => "Cerrar"}
          %span{"aria-hidden" => "true"} &times;
      .modal-body
        .alert.alert-secondary.py-2.mb-3
          %strong Actividad:
          %span#modal_titulo_actividad.font-italic

        #bitacora_historial_container.mb-3{style: "max-height: 250px; overflow-y: auto;"}

        #seccion_nuevo_comentario
          %hr
          .form-group.mb-0
            %label.font-weight-bold.text-danger{for: "nuevo_comentario_modal"}
              %i.fa.fa-pencil.mr-1
              Agregar Nuevo Comentario:
            %textarea#nuevo_comentario_modal.form-control.border-text{rows: 3, placeholder: "Escriba aquí el comentario u observación..."}

      .modal-footer
        %button.btn.btn-sm.btn-secondary#btn_cerrar_modal{type: "button", "data-dismiss" => "modal"} Cerrar
        %button.btn.btn-sm.btn-primary#btn_guardar_modal{type: "button", onclick: "guardarComentarioModal()"}
          %i.fa.fa-plus-circle.mr-1
          Añadir Entrada a Bitácora