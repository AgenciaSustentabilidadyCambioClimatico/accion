- fpl_objeto = @fondo_produccion_limpia || FondoProduccionLimpia.new
- titulo "Verificación Contable de Rendición"

-# Obtención del mes actual en verificación
- mes_actual = @rendicion&.mes_a_rendir.to_s
- fecha_res = fpl_objeto.try(:fecha_resolucion)
- mes_nombre = nil
- if fecha_res.present?
  - fecha_target = fecha_res.to_date + (mes_actual.to_i - 1).months
  - mes_nombre = (I18n.l(fecha_target, format: '%B %Y') rescue fecha_target.strftime('%B %Y')).capitalize

- texto_mes_display = mes_nombre.present? ? "#{mes_nombre} (Rendición #{mes_actual})" : "Rendición #{mes_actual}"

-# -------------------------------------------------------------
-# 1. PREPARACIÓN DE DATOS - ACTIVIDADES Y ESTADO DE RENDICIONES
-# -------------------------------------------------------------
- detalles_hash = (@actividad_detalle.presence || PlanActividad.where(flujo_id: @tarea_pendiente&.flujo_id)).index_by { |d| (d.try(:actividad_id).presence || d.id).to_i } rescue {}
- rendiciones_todas = RendicionFpl.where(flujo_id: @tarea_pendiente&.flujo_id).includes(rendicion_detalles_fpl: :rendicion_detalle_actividades_fpl).order(mes_a_rendir: :asc).to_a rescue []
- get_estado_num = lambda { |r| (r.read_attribute_before_type_cast(:estado) || r.estado).to_i }

- max_avances = Hash.new(0)
- rendiciones_todas.each do |rend|
  - est_num = get_estado_num.call(rend)
  - rend.rendicion_detalles_fpl.each do |det|
    - next unless (det.tecnica? rescue det.tipo_tab.to_i == 0)
    - val_av = det.nivel_avance.to_i
    - det.rendicion_detalle_actividades_fpl.each do |rda|
      - t_id = rda.plan_actividad_id.to_i
      - max_avances[t_id] = [max_avances[t_id], val_av].max

- suma_pct = 0
- actividades_list = (@actividad_x_linea || []).map do |act|
  - plan_act = detalles_hash[act.id.to_i] || PlanActividad.find_by(id: act.id) || PlanActividad.find_by(flujo_id: @tarea_pendiente&.flujo_id, actividad_id: act.id)
  - act_id_num = act.id.to_i
  - plan_act_id_num = plan_act.try(:id).to_i
  - mis_ids = [act_id_num, plan_act_id_num].reject(&:zero?).uniq
  - av = mis_ids.map { |id| max_avances[id] }.max || 0
  - suma_pct += av
  - { id: act.id, correlativo: act.correlativo, nombre: act.nombre, avance: av, mis_ids: mis_ids }

- pct_proyecto = actividades_list.any? ? (suma_pct.to_f / actividades_list.size) : 0
- es_proyecto_100 = pct_proyecto.round(1) >= 100.0
- estados_map = { 0 => 'En borrador', 1 => 'Enviada / En revisión', 2 => 'Enviada / En revisión', 3 => 'Observada', 4 => 'Observada', 5 => 'Aceptada', 6 => 'Aceptada' }

:javascript
  const ES_PROYECTO_100 = #{es_proyecto_100 ? 'true' : 'false'};

  $(document).ready(function() {
    $('.chosen-control').chosen({
      allow_single_deselect: true,
      no_results_text: 'No se encontraron resultados',
      width: '100%'
    });
    htmlErrorToTooltip('top');
    validarFormulario();
  });

  function validarFormulario() {
    const botonEnviar = document.getElementById('enviar-button');
    if (botonEnviar) {
      botonEnviar.disabled = !ES_PROYECTO_100;
      if (ES_PROYECTO_100) {
        botonEnviar.classList.remove('btn-disabled');
      } else {
        botonEnviar.classList.add('btn-disabled');
      }
    }
  }

:css
  .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table { width: 100%; max-width: 100%; margin-bottom: 1rem; background-color: transparent; }
  .table tbody + tbody { border-top: 2px solid #dee2e6; }
  .table .table { background-color: #fff; }
  .table thead th { font-size: 12px; border: 2px solid #dee2e6; }
  .encabezado-form { vertical-align: middle; background-color: #E0EFF6; text-align: center; font-weight: bold; }
  .contenido-form { border: 2px solid #dee2e6; font-size: 12px; vertical-align: top; background-color: #fff; color: #5d759e; }
  .smaller-text { font-size: 11px !important; height: auto !important; padding: 2px 4px !important; }
  .border-text { border: 1px solid #cccccc; border-radius: 4px; background-color: #ffffff; }
  .label-estilo { color: #5d759e; font-weight: 400; font-size: 14px; }
  .header-actividad-fpl { background-color: #E0EFF6 !important; border: 2px solid #dee2e6 !important; padding: 8px 12px !important; color: #333 !important; font-weight: bold; }

-# VISTA PRINCIPAL
.row
  .col-12
    .card.mb-3
      .card-header.p-0
        .p-3
          %h5.no-margin= titulo_instrumento_fpl.html_safe
          %h5.no-margin= titulo_instrumento.html_safe
          %h5.no-margin= titulo_proyecto_fpl.html_safe
          %h5.no-margin= titulo_apl.html_safe
          %h5.no-margin= datos_beneficiario_fpl.html_safe

-# NAVEGACIÓN POR PESTAÑAS (NAV-TABS)
#tab-menu-controls.mb-0.mt-3.px-2{:role => "tabpanel"}
  %ul#manifestacion.nav.nav-tabs{:role => "tablist"}
    %li.nav-item.tab-block
      %a.nav-link.active#actividades-tab{"aria-controls" => "actividades", "aria-expanded" => "true", "data-toggle" => "tab", :href => "#actividades", :role => "tab"}
        Actividades y Rendiciones
    %li.nav-item.tab-block
      %a.nav-link#costos-tab{"aria-controls" => "costos", "aria-expanded" => "false", "data-toggle" => "tab", :href => "#costos", :role => "tab"}
        Estructura de Costos

= simple_form_for fpl_objeto, url: guardar_verificacion_contable_rendicion_fondo_produccion_limpia_path(@tarea_pendiente), html: { autocomplete: :off }, remote: true do |f|
  = hidden_field_tag "mes_a_rendir", mes_actual.presence || @rendicion&.mes_a_rendir || 1

  .tab-content#manifestacionContent.mt-3

    -# TAB 1: LISTADO ACTIVIDADES Y ESTADO RENDICIONES
    .tab-pane.fade.show.active#actividades{:role => "tabpanel", "aria-labelledby" => "actividades-tab"}
      .card.mb-3{style: "border: 2px solid #dee2e6;"}
        .card-header.header-actividad-fpl
          .d-flex.align-items-center
            %span.font-weight-bold{style: "color: #333; font-size: 14px;"} Resumen General de Avances y Rendiciones

        .card-body.p-3
          .row
            .col-lg-12
              .table-responsive.mb-3
                %table.table.table-striped.no-margin
                  %thead
                    %tr
                      %th.encabezado-form.text-left Actividades
                      %th.encabezado-form.text-center{style: "width: 170px;"} % Ejecución
                  %tbody
                    - actividades_list.each do |act_info|
                      - mis_ids = act_info[:mis_ids]
                      
                      - es_en_proceso = false
                      - max_avance_aprobado = 0
                      - max_avance_proceso  = 0
                      - max_avance_borrador = 0

                      - rendiciones_todas.each do |r|
                        - est_r = get_estado_num.call(r)
                        - r.rendicion_detalles_fpl.each do |det|
                          - next unless (det.tecnica? rescue det.tipo_tab.to_i == 0)
                          - ids_asoc = det.rendicion_detalle_actividades_fpl.map(&:plan_actividad_id).map(&:to_i)
                          - if (ids_asoc & mis_ids).present?
                            - av = det.nivel_avance.to_i
                            - if [1, 2].include?(est_r)
                              - es_en_proceso = true
                              - max_avance_proceso = [max_avance_proceso, av].max
                            - elsif [5, 6].include?(est_r)
                              - max_avance_aprobado = [max_avance_aprobado, av].max
                            - elsif [0, 3, 4].include?(est_r)
                              - max_avance_borrador = [max_avance_borrador, av].max

                      %tr
                        %td.contenido-form= "#{act_info[:correlativo]} #{act_info[:nombre]}"
                        %td.contenido-form.text-center
                          - if es_en_proceso
                            %span.badge.badge-warning.text-white{style: "font-size: 11px; padding: 6px; background-color: #fd7e14; display: block; width: 100%;"}
                              = "En revision ASCC (#{max_avance_proceso}%)"
                          - elsif max_avance_aprobado >= 100
                            %span.badge.badge-success{style: "font-size: 11px; padding: 6px; display: block; width: 100%;"}
                              Finalizada 100%
                          - elsif max_avance_borrador > 0
                            %span.badge.badge-info.text-white{style: "font-size: 11px; padding: 6px; display: block; width: 100%;"}
                              = "Borrador (#{max_avance_borrador}%)"
                          - elsif max_avance_aprobado > 0
                            %span.badge.badge-primary{style: "font-size: 11px; padding: 6px; display: block; width: 100%;"}
                              = "en Ejecución (#{max_avance_aprobado}%)"
                          - else
                            %span{style: "font-size: 12px; color: #5d759e;"}= "0%"

                    %tr.bg-light
                      %td.contenido-form.font-weight-bold.text-right Porcentaje Avance Proyecto:
                      %td.contenido-form.text-center.font-weight-bold
                        %span.badge.badge-secondary{style: "font-size: 12px; padding: 6px 12px;"}
                          = "#{pct_proyecto.round(1)}%"

            .col-lg-12
              .table-responsive.mb-3
                %table.table.table-striped.no-margin
                  %thead
                    %tr
                      %th.encabezado-form{colspan: 2, style: "border-bottom: none;"}
                      %th.encabezado-form{colspan: 2} Informes Revisión
                    %tr
                      %th.encabezado-form Estado Rendiciones
                      %th.encabezado-form Estado
                      %th.encabezado-form Actividades
                      %th.encabezado-form Financiero
                  %tbody
                    - rendiciones_todas.each do |r|
                      - estado_desc = estados_map[get_estado_num.call(r)] || 'En proceso'
                      - f_target = fecha_res.to_date + (r.mes_a_rendir.to_i - 1).months rescue Date.today
                      - m_lbl = (I18n.l(f_target, format: '%B %Y') rescue '').capitalize
                      %tr
                        %td.contenido-form= "#{m_lbl} (Rendición #{r.mes_a_rendir})"
                        %td.contenido-form.text-center= estado_desc
                        - if get_estado_num.call(r) >= 1
                          %td.contenido-form.text-center= link_to 'descargar revisión', descargar_informe_actividades_fondo_produccion_limpia_path(@tarea_pendiente, mes_a_rendir: r.mes_a_rendir), target: '_blank', class: 'text-info'
                          %td.contenido-form.text-center= link_to 'descargar revisión', descargar_informe_gastos_fondo_produccion_limpia_path(@tarea_pendiente, mes_a_rendir: r.mes_a_rendir), target: '_blank', class: 'text-info'
                        - else
                          %td.contenido-form.text-center --
                          %td.contenido-form.text-center --

    -# TAB 2: ESTRUCTURA DE COSTOS (FONDO PL, BENEFICIARIO Y TOTAL DESTACADO AL FINAL)
    .tab-pane.fade#costos{:role => "tabpanel", "aria-labelledby" => "costos-tab"}
      - data_costos = @data_costos || { total: {}, fpl: {}, aporte: {} }
      - items_costo = @partidas || [ { key: :rrhh_propios, nombre: 'RR HH Propios' }, { key: :rrhh_externos, nombre: 'RR HH Externos' }, { key: :gastos_operacion, nombre: 'Gastos de Operación' }, { key: :gastos_administracion, nombre: 'Gastos de Administración' } ]

      -# 1. TABLAS PARCIALES LADO A LADO
      .row
        - [{ titulo: "A Cargo del Fondo PL", tipo: :fpl }, { titulo: "A Cargo del Beneficiario", tipo: :aporte }].each do |tabla|
          .col-12.col-lg-6.mb-3
            .card.h-100{style: "border: 2px solid #dee2e6;"}
              .card-header.header-actividad-fpl
                .d-flex.align-items-center
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= tabla[:titulo]
              .card-body.p-2
                .table-responsive
                  %table.table.table-striped.no-margin
                    %thead
                      %tr
                        %th.encabezado-form.text-left Ítem de Gasto
                        %th.encabezado-form Total
                        %th.encabezado-form Gastos Rendidos
                        %th.encabezado-form por Rendir
                        %th.encabezado-form % Ejecución
                    %tbody
                      - items_costo.each do |item|
                        - node = data_costos.dig(tabla[:tipo], item[:key]) || { tot: 0.0, ren: 0.0 }
                        - tot = node[:tot].to_f
                        - ren = node[:ren].to_f
                        - por_rendir = tot - ren
                        - pct = tot > 0 ? (ren / tot * 100) : 0
                        %tr
                          %td.contenido-form= item[:nombre]
                          %td.contenido-form.text-right= number_to_currency(tot, unit: '$', precision: 0)
                          %td.contenido-form.text-right= number_to_currency(ren, unit: '$', precision: 0)
                          %td.contenido-form.text-right= number_to_currency(por_rendir, unit: '$', precision: 0)
                          %td.contenido-form.text-center= number_to_percentage(pct, precision: 1)

                      -# FILA TOTAL PARCIAL POR TABLA
                      - nodes_hash = data_costos[tabla[:tipo]] || {}
                      - tot_gen = nodes_hash.values.sum { |v| v[:tot].to_f }
                      - ren_gen = nodes_hash.values.sum { |v| v[:ren].to_f }
                      - pct_gen = tot_gen > 0 ? (ren_gen / tot_gen * 100) : 0
                      %tr.bg-light
                        %td.contenido-form.font-weight-bold TOTAL
                        %td.contenido-form.text-right.font-weight-bold= number_to_currency(tot_gen, unit: '$', precision: 0)
                        %td.contenido-form.text-right.font-weight-bold= number_to_currency(ren_gen, unit: '$', precision: 0)
                        %td.contenido-form.text-right.font-weight-bold= number_to_currency(tot_gen - ren_gen, unit: '$', precision: 0)
                        %td.contenido-form.text-center.font-weight-bold= number_to_percentage(pct_gen, precision: 1)

      -# 2. TABLA DESTACADA: TOTAL DEL PROYECTO (AL FINAL DE LA PESTAÑA)
      .row.mt-2
        .col-12
          .card.mb-3{style: "border: 2px solid #5d759e;"}
            .card-header{style: "background-color: #5d759e; color: #fff; padding: 10px 15px;"}
              .d-flex.align-items-center.justify-content-between
                %span.font-weight-bold{style: "font-size: 15px;"}
                  %i.fa.fa-calculator.mr-2
                  Total del Proyecto (Consolidado)
                %span.badge.badge-light{style: "font-size: 11px; color: #5d759e;"} Resumen General

            .card-body.p-2
              .table-responsive
                %table.table.table-striped.no-margin
                  %thead
                    %tr
                      %th.encabezado-form.text-left{style: "background-color: #cbe3f5;"} Ítem de Gasto
                      %th.encabezado-form{style: "background-color: #cbe3f5;"} Presupuesto Total
                      %th.encabezado-form{style: "background-color: #cbe3f5;"} Gastos Rendidos
                      %th.encabezado-form{style: "background-color: #cbe3f5;"} Pendiente por Rendir
                      %th.encabezado-form{style: "background-color: #cbe3f5;"} % Ejecución Acumulada
                  %tbody
                    - items_costo.each do |item|
                      - node = data_costos.dig(:total, item[:key]) || { tot: 0.0, ren: 0.0 }
                      - tot = node[:tot].to_f
                      - ren = node[:ren].to_f
                      - por_rendir = tot - ren
                      - pct = tot > 0 ? (ren / tot * 100) : 0
                      %tr
                        %td.contenido-form.font-weight-bold= item[:nombre]
                        %td.contenido-form.text-right= number_to_currency(tot, unit: '$', precision: 0)
                        %td.contenido-form.text-right= number_to_currency(ren, unit: '$', precision: 0)
                        %td.contenido-form.text-right= number_to_currency(por_rendir, unit: '$', precision: 0)
                        %td.contenido-form.text-center
                          %span= number_to_percentage(pct, precision: 1)

                    -# FILA TOTAL CONSOLIDADO DESTACADA
                    - nodes_hash = data_costos[:total] || {}
                    - tot_gen = nodes_hash.values.sum { |v| v[:tot].to_f }
                    - ren_gen = nodes_hash.values.sum { |v| v[:ren].to_f }
                    - pct_gen = tot_gen > 0 ? (ren_gen / tot_gen * 100) : 0
                    %tr{style: "background-color: #e0eff6;"}
                      %td.contenido-form.font-weight-bold{style: "font-size: 13px; color: #004085;"} TOTAL CONSOLIDADO PROYECTO
                      %td.contenido-form.text-right.font-weight-bold{style: "font-size: 13px; color: #004085;"}= number_to_currency(tot_gen, unit: '$', precision: 0)
                      %td.contenido-form.text-right.font-weight-bold{style: "font-size: 13px; color: #28a745;"}= number_to_currency(ren_gen, unit: '$', precision: 0)
                      %td.contenido-form.text-right.font-weight-bold{style: "font-size: 13px; color: #dc3545;"}= number_to_currency(tot_gen - ren_gen, unit: '$', precision: 0)
                      %td.contenido-form.text-center.font-weight-bold{style: "font-size: 13px;"}
                        %span.badge.badge-dark{style: "font-size: 12px; padding: 6px 12px;"}
                          = number_to_percentage(pct_gen, precision: 1)

  -# SECCIÓN INFERIOR: DICTAMEN CONTABLE Y BOTONES
  -#
    .card.mt-3{style: 'border: 2px solid #dee2e6;'}
      .card-header.header-actividad-fpl
        %h5.no-margin.font-weight-bold Dictamen de Verificación Contable
      .card-body
        .row
          .col-12
            %label.font-weight-bold Comentario de Auditoría / Verificación Contable (Optativo)
            = text_area_tag "comentario_contable", @rendicion&.try(:comentario_contable), class: "form-control border-text", rows: 3, placeholder: "Ingrese observaciones o notas de auditoría contable..."

  .d-flex.justify-content-between.align-items-center.mt-4.mb-5
    .left-actions
      - if @rendicion.present?
        = link_to descargar_informe_gastos_fondo_produccion_limpia_path(@tarea_pendiente, mes_a_rendir: @rendicion.mes_a_rendir), class: "btn btn-sm btn-info", target: "_blank", data: { toggle: "tooltip" }, title: "Descargar Informe de Gastos PDF" do
          %i.fa.fa-file-pdf-o.mr-1
          Descargar Informe de Gastos

    .right-actions
      = volver_root
      - if @tiene_permisos
        = button_tag "Aprobar Verificación Contable", 
          type: 'submit', 
          name: 'commit_type', 
          value: 'enviar', 
          id: 'enviar-button', 
          class: "btn btn-sm btn-success ml-2 #{'btn-disabled' unless es_proyecto_100}", 
          disabled: !es_proyecto_100, 
          title: (es_proyecto_100 ? "" : "El porcentaje de avance del proyecto debe estar al 100% para aprobar la verificación contable"), 
          data: { confirm: "¿Está seguro que desea dar por APROBADA la verificación contable de esta rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando..." }