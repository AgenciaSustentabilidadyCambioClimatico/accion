            .card-body.p-3
              .table-responsive
                %table.table.table-striped.no-margin
                  %thead
                    %tr
                      %th.encabezado-form{style: 'width: 50%;'} Declaración
                      %th.encabezado-form{style: 'width: 20%;'} Cumple
                      %th.encabezado-form{style: 'width: 30%;'} Comentarios / Bitácora
                  %tbody
                    %tr
                      %td.contenido-form
                        %span.font-weight-bold Rendición Sin Movimientos Financieros FPL
                        %br
                        %small.text-muted Sin gastos ni comprobantes rendidos en el período.
                      %td.contenido-form
                        - if @es_revision_financiera
                          = select_tag "detalles[#{detalle_eval.id}][cumple]", options_for_select([['Seleccione...', ''], ['Sí', 1], ['No', 2]], valor_cumple_int), class: "form-control smaller-text border-text #{'is-invalid border-danger' if valor_cumple_int == 2}", id: "cumple_#{detalle_eval.id}", onchange: "toggleComentariosRevisor(this, '#{detalle_eval.id}')"
                        - else
                          - if valor_cumple_int == 1
                            %span.badge.badge-success{style: 'font-size: 10px; padding: 5px 10px;'} Sí
                          - elsif valor_cumple_int == 2
                            %span.badge.badge-danger{style: 'font-size: 10px; padding: 5px 10px;'} No
                          - else
                            %span.text-muted --
