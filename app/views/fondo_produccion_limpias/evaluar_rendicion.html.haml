            - gastos_aporte = obtener_gastos_actividad.call(actividad.id, ['aporte propio valorado', 'aporte propio liquido', 'aporte_propio_valorado', 'aporte_propio_liquido'])

            .card.mb-3.actividad-aporte-block{id: "aporte_actividad_card_#{actividad.id}", style: (es_actividad_observada_aporte ? "border: 2px solid #dc3545;" : "border: 2px solid #dee2e6;")}
              .card-header.d-flex.justify-content-between.align-items-center.header-actividad-fpl{class: ('header-actividad-observada' if es_actividad_observada_aporte)}
                .d-flex.align-items-center.flex-wrap
                  %span.badge.badge-primary.mr-2{style: "font-size: 11px;"}= actividad.correlativo
                  %span.font-weight-bold{style: "color: #333; font-size: 14px;"}= actividad.nombre
                  - if es_reitimizada
                    %span.badge.ml-2{style: "font-size: 11px; background-color: #6f42c1; color: #ffffff;", title: "Actividad Reitimizada Autorizada"}
                      %i.fa.fa-refresh.mr-1
                      Reitemización autorizada
                  - if es_actividad_observada_aporte
                    %span.badge.badge-danger.ml-2{style: "font-size: 11px; padding: 4px 8px; background-color: #dc3545;", title: "Esta actividad fue observada en la revisión de aporte propio"}
                      %i.fa.fa-exclamation-triangle.mr-1
                      Observada
                %a.btn.btn-sm.btn-outline-info{"data-toggle" => "collapse", href: "#collapse_aporte_eval_#{actividad.id}", role: "button", "aria-expanded" => "true", style: "background-color: #fff; font-size: 11px;"}
                  %i.fa.fa-chevron-down.mr-1
                  Ver / Ocultar

              .collapse.show{id: "collapse_aporte_eval_#{actividad.id}"}
                .card-body.p-2
                  = render 'tabla_desglose_gastos_actividad', gastos: gastos_aporte, actividad_id: actividad.id, es_editable: false, map_base: @rendicion_gastos_map, es_reitimizada: es_reitimizada

                  - if @es_revision_financiera
                    .table-responsive.mt-3
                      %table.table.table-striped.no-margin
                        %thead
                          %tr
                            %th.encabezado-form{style: 'width: 35%;'} Archivos Cargados
                            %th.encabezado-form{style: 'width: 15%;'} Cumple
                            %th.encabezado-form{style: 'width: 50%;'} Comentarios
                        %tbody
                          - if docs_act.present?
                            - docs_act.each do |doc|
                              - raw_cumple = doc.read_attribute_before_type_cast(:cumple) || doc.cumple
                              - val_str = raw_cumple.to_s.downcase
                              - valor_cumple_int = ['1', 'si', 'true'].include?(val_str) ? 1 : (['2', 'no', 'false'].include?(val_str) ? 2 : nil)
                              - valor_comentario = doc.comentario_revisor
                              - comentario_postulante_val = doc.try(:comentario_postulante)
                              - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                              - num_comentarios_rev = valor_comentario.to_s.split("\n").reject(&:blank?).count

                              %tr
                                %td.contenido-form= __descargar_archivo_sin_titulo(archivo, doc || f.object)
                                %td.contenido-form
                                  = select_tag "detalles[#{doc.id}][cumple]", options_for_select([['Seleccione...', ''], ['Sí', 1], ['No', 2]], valor_cumple_int), class: "form-control smaller-text border-text #{'is-invalid border-danger' if valor_cumple_int == 2}", id: "cumple_#{doc.id}", onchange: "toggleComentariosRevisor(this, '#{doc.id}')"
                                %td.contenido-form.text-center
                                  = hidden_field_tag "comentario_postulante_#{doc.id}", comentario_postulante_val, id: "comentario_postulante_#{doc.id}"
                                  = hidden_field_tag "detalles[#{doc.id}][comentario_revisor]", valor_comentario, id: "comentario_revisor_#{doc.id}"
                                  %button.btn.btn-sm.w-100{class: (valor_cumple_int == 2 && valor_comentario.to_s.strip.empty? ? 'btn-danger' : 'btn-primary'), type: 'button', onclick: "abrirModalComentarios('#{doc.id}', '#{j actividad.nombre}', 'comentario_revisor_', 'comentario_postulante_', false)"}
                                    %i.fa.fa-comments.mr-1
                                    Bitácora
                                  .mt-1{id: "preview_comentario_revisor_#{doc.id}"}
                                    %span.badge{class: num_comentarios_rev > 0 ? 'badge-info' : 'badge-secondary'}
                                      %i.fa.fa-comments
                                      = "#{num_comentarios_rev} registro(s)"
                          - else
                            %tr
                              %td.contenido-form.text-muted.text-center Sin documentos cargados
                              %td.contenido-form.text-center --
                              %td.contenido-form.text-center --
                  - else
                    .table-responsive.mt-2
                      %table.table.table-striped.no-margin
                        %thead
                          %tr
                            %th.encabezado-form{style: 'width: 100%;'} Archivos Cargados
                        %tbody
                          - if docs_act.present?
                            - docs_act.each do |doc|
                              - archivo = doc.respond_to?(:archivo) ? doc.archivo : nil
                              %tr
                                %td.contenido-form
                                  = __descargar_archivo_sin_titulo(archivo, doc || f.object)
                          - else
                            %tr
                              %td.contenido-form.text-muted.text-center Sin documentos cargados
        - else
          .card.mt-2
            .card-body.text-center.text-muted No hay documentos de aporte para evaluar en este mes.
      - else
        .card.mt-2
          .card-body.text-center.text-muted No se enviaron documentos de aporte para evaluar.

  .float-right.mt-3
    = volver_root
    - if @tiene_permisos
      = button_tag "Grabar Avance", 
        type: 'submit', 
        name: 'commit_type', 
        value: 'grabar', 
        class: "btn btn-sm btn-primary mr-2", 
        data: { disable_with: "<i class='fa fa-spinner fa-spin'></i> Grabando..." }

      = button_tag t(:enviar_evaluacion), 
        type: 'submit', 
        name: 'commit_type', 
        value: 'enviar', 
        id: 'enviar-button', 
        class: "btn btn-sm btn-success btn-disabled", 
        disabled: true, 
        data: { confirm: "¿Está seguro que desea enviar la evaluación de esta rendición?", disable_with: "<i class='fa fa-spinner fa-spin'></i> Enviando..." }

/ ----------------------------------------------------
/ MODAL POPUP: BITÁCORA Y HISTORIAL DE COMENTARIOS
/ ----------------------------------------------------
.modal.fade#modalBitacoraComentarios{tabindex: "-1", role: "dialog", "aria-labelledby" => "modalBitacoraLabel", "aria-hidden" => "true"}
  .modal-dialog.modal-lg{role: "document"}
    .modal-content
      .modal-header.bg-info.text-white
        %h5.modal-title#modalBitacoraLabel
          %i.fa.fa-comments.mr-2
          %span#modalBitacoraLabelText Bitácora de Comentarios
        %button.close.text-white{type: "button", "data-dismiss" => "modal", "aria-label" => "Cerrar"}
          %span{"aria-hidden" => "true"} &times;
      .modal-body
        .alert.alert-secondary.py-2.mb-3
          %strong Actividad / Declaración:
          %span#modal_titulo_actividad.font-italic

        #bitacora_historial_container.mb-3{style: "max-height: 250px; overflow-y: auto;"}

        #seccion_nuevo_comentario
          %hr
          .form-group.mb-0
            %label.font-weight-bold.text-danger{for: "nuevo_comentario_modal"}
              %i.fa.fa-pencil.mr-1
              Agregar Nuevo Comentario (Revisor):
            %textarea#nuevo_comentario_modal.form-control.border-text{rows: 3, placeholder: "Escriba aquí la observación o comentario..."}

      .modal-footer
        %button.btn.btn-sm.btn-secondary#btn_cerrar_modal{type: "button", "data-dismiss" => "modal"} Cancelar
        %button.btn.btn-sm.btn-primary#btn_guardar_modal{type: "button", onclick: "guardarComentarioModal()"}
          %i.fa.fa-plus-circle.mr-1
          Añadir Entrada a Bitácora