- unless adjuntos.size > 0
  .center-text
    = '--'
- else
  - da = "lista-archivos-modal-id-#{item.id}"
  = link_to '#', "data-toggle" => :modal, "data-target" => "##{da}" do
    %i.fa.fa-paperclip
  .modal.fade{id: da, tabindex: "-1", role: :dialog, "aria-labelledby" => :listaArchivosLabel, "aria-hidden" => true}
    .modal-dialog.modal-dialog-centered.modal-lg{role: :document}
      .modal-content
        .modal-header
          %h5.modal-title#listaArchivosLabel
          %button.close{type: :button, "data-dismiss" => :modal, "aria-label" => :close}
            %span{"aria-hidden" => true}
              &times;
        .modal-body
          - adjuntos.each do |o|
            - next unless o.present? && o.archivo.present?

            -# 1. Nombre original y extensión de forma segura
            - nombre_archivo = o.archivo.identifier.presence || o.archivo.file&.filename || "archivo"
            - ext = (o.archivo.file&.extension || File.extname(nombre_archivo).delete('.')).downcase
            - campo = o.archivo.mounted_as rescue 'archivo'

            -# 2. Generación de URL a través del Proxy (pasando disposition: 'inline' para visualización)
            - url_proxy = archivo_generico_path(modelo: o.class.name.underscore, id: o.id, campo: campo, disposition: 'inline')

            -# 3. Renderizado según el tipo de archivo
            - if %w{jpg png jpeg webp gif}.include?(ext)
              = image_tag(url_proxy, style: 'width:100%', class: 'margin-bottom-10', alt: nombre_archivo)

            - elsif ext == 'pdf'
              %embed{src: url_proxy, width: "100%", height: "720px", type: 'application/pdf'}

            - else
              -# Para archivos Word, Excel u otros que no se pueden incrustar en HTML
              .text-center.my-3.p-3.border.rounded
                %i.fa.fa-file-text-o.fa-2x.mb-2
                %p.mb-2= nombre_archivo
                = link_to url_proxy, class: "btn btn-sm btn-outline-primary", target: "_blank", download: nombre_archivo do
                  %i.fa.fa-download
                  Descargar archivo
        .modal-footer
          %button.btn.btn-secondary{type: :button, "data-dismiss" => :modal}
            Cerrar